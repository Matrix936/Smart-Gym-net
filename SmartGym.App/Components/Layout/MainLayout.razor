@* MainLayout (AppLayout.tsx): sidebar colapsable 260↔72 (logo + nav agrupada) y topbar glass
   con fecha/hora es-MX, badge de sincronización, cambio de tema y avatar con menú de usuario. *@
@using System.Globalization
@using SmartGym.Core.Repositories
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject ISessionState Session
@inject IAuthService Auth
@inject IEmpresaConfigFiscalRepository EmpresaRepo
@inject ILogoStorage LogoStorage
@inject SmartGym.App.Services.ILogoState LogoState
@implements IDisposable

<div class="sg-shell @(_collapsed ? "sg-shell-collapsed" : null)">
    <aside class="sg-sidebar">
        <SidebarHeader LogoUrl="@_logoUrl" NombreComercial="@_nombreEmpresa" />
        <NavMenu Mini="_collapsed" />
    </aside>

    <div class="sg-main">
        <header class="sg-topbar">
            <button class="sg-topbar-menu" @onclick="ToggleSidebar" aria-label="Alternar menú" title="Alternar menú">
                @* Morfeo hamburguesa/X — mismo mecanismo del morfeo de tablas
                   (09319ec): dos SVG superpuestos + clase condicional sobre el
                   ESTADO REAL (_collapsed), que ya cubre toggle manual y
                   auto-colapso por navegación. Sin atributos ARIA de por medio. *@
                <span class="sidebar-morph @(!_collapsed ? "abierto" : "")">
                    <svg class="morph-lines" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
                    <svg class="morph-x" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.41 13.41 12z"/></svg>
                </span>
            </button>
            <span class="topbar-spacer"></span>
            <div class="topbar-datetime">
                <span class="topbar-date">@_fecha</span>
                <span class="topbar-time">@_hora</span>
            </div>
            <div class="sync-badge" title="Estado de sincronización">
                <span class="sync-dot"></span>
                <span>Sincronizado</span>
            </div>
            <ThemeToggle />
            <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" paperClass="sg-user-paper">
                <ActivatorContent>
                    @* MudBlazor v9: ActivatorContent recibe MenuContext; hay que llamar
                       context.ToggleAsync explicito (ver MiembrosPage.razor para la referencia). *@
                    <MudIconButton Class="sg-user-button" OnClick="@context.ToggleAsync" aria-label="Menú de usuario">
                        <MudAvatar Class="sg-user-avatar">@_iniciales</MudAvatar>
                    </MudIconButton>
                </ActivatorContent>
                <ChildContent>
                    <MudMenuItem Disabled="true" Class="sg-user-header">@Session.Current?.Nombre</MudMenuItem>
                    <MudDivider />
                    <MudMenuItem OnClick="IrMiPerfil">
                        <MudIcon Icon="@Icons.Material.Filled.ManageAccounts" Size="Size.Small" Class="sg-user-item-icon" />
                        Mi Perfil
                    </MudMenuItem>
                    <MudMenuItem OnClick="IrConfiguracion">
                        <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="sg-user-item-icon" />
                        Configuración
                    </MudMenuItem>
                    <MudMenuItem OnClick="Salir">
                        <MudIcon Icon="@Icons.Material.Filled.Logout" Size="Size.Small" Class="sg-user-item-icon" />
                        Salir
                    </MudMenuItem>
                </ChildContent>
            </MudMenu>
        </header>

        <main class="sg-content">
            <div class="content-pad">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    private static readonly CultureInfo EsMx = CultureInfo.GetCultureInfo("es-MX");

    private bool _collapsed;
    private string _logoUrl = string.Empty;
    private string _nombreEmpresa = "Smart Gym";
    private string _iniciales = "?";
    private string _fecha = string.Empty;
    private string _hora = string.Empty;
    private Timer? _reloj;

    protected override async Task OnInitializedAsync()
    {
        // El sidebar persiste entre navegaciones: si Configuración cambia el
        // logo, el evento lo refresca sin recargar la app (patrón ThemeState).
        LogoState.Changed += OnLogoChanged;
        _logoUrl = LogoStorage.LeerDataUrl() ?? string.Empty;

        // Auto-colapso: el sidebar arranca colapsado y se colapsa en CADA
        // navegación (el usuario puede expandirlo puntualmente, pero cambiar
        // de módulo lo resetea — sin persistencia del estado expandido).
        Nav.LocationChanged += OnUbicacionCambio;

        var empresa = await EmpresaRepo.GetAsync();
        if (empresa is not null && !string.IsNullOrWhiteSpace(empresa.NombreComercial))
        {
            _nombreEmpresa = empresa.NombreComercial;
        }

        var nombre = Session.Current?.Nombre ?? string.Empty;
        _iniciales = InicialesDe(nombre);

        _reloj = new Timer(_ => InvokeAsync(ActualizarReloj), null, 0, 1000);
    }

    private void OnUbicacionCambio(object? sender, LocationChangedEventArgs e)
    {
        _collapsed = true;
        InvokeAsync(StateHasChanged);
    }

    private static string InicialesDe(string nombre)
    {
        var partes = nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (partes.Length == 0)
        {
            return "?";
        }

        return string.Concat(partes.Take(2).Select(p => char.ToUpperInvariant(p[0])));
    }

    private void ActualizarReloj()
    {
        var ahora = DateTime.Now;
        var fecha = ahora.ToString("dddd, d 'de' MMMM 'de' yyyy", EsMx);
        _fecha = char.ToUpperInvariant(fecha[0]) + fecha[1..];
        _hora = ahora.ToString("h:mm tt", EsMx).ToUpperInvariant();
        StateHasChanged();
    }

    private async Task ToggleSidebar()
    {
        // Expansión puntual del usuario: dura hasta la próxima navegación.
        _collapsed = !_collapsed;
    }

    private void OnLogoChanged()
    {
        _logoUrl = LogoStorage.LeerDataUrl() ?? string.Empty;
        InvokeAsync(StateHasChanged);
    }

    private void IrMiPerfil() => Nav.NavigateTo("/mi-perfil");

    private void IrConfiguracion() => Nav.NavigateTo("/configuracion");

    private async Task Salir()
    {
        await Auth.LogoutAsync(Session.Current?.Token ?? string.Empty);
        Nav.NavigateTo("/", forceLoad: true);
    }

    public void Dispose()
    {
        LogoState.Changed -= OnLogoChanged;
        Nav.LocationChanged -= OnUbicacionCambio;
        _reloj?.Dispose();
    }
}