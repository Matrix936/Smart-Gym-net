@page "/membresias"
@* MembresiasPage: listado paginado de las membresías de la sede, con estado
   efectivo calculado (activa vence por fecha_fin — misma semántica que
   MembresiaEstadoCalculator). Acciones por fila vía SocioMembresiasDialog
   (congelar/cancelar con reautorización ya implementados ahí). El catálogo
   de planes vive en /planes. *@
@implements IDisposable
@using System.Globalization
@using MudBlazor
@using SmartGym.Core.Authorization
@using SmartGym.Core.Common
@using SmartGym.Core.Entities
@using SmartGym.Core.Services
@using SmartGym.App.Services

<div class="page-head">
    <div>
        <h4>Membresías</h4>
        <p class="page-sub">Suscripciones de los socios y su estado actual.</p>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AbrirVenta">Nueva venta</MudButton>
</div>

<div class="glass-panel">
    <div class="page-toolbar">
        @* Búsqueda pegada a la izquierda; todos los filtros van del otro lado.
           La sede es un filtro secundario APAGADO por defecto (patrón
           FiltrosDesplegables): encenderla muestra "Todas las sedes" y solo
           filtra cuando se elige una específica. *@
        <MudTextField T="string"
                      Class="search-field"
                      Placeholder="Buscar por nombre del socio..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Margin="Margin.Dense"
                      Clearable="true"
 Immediate="true"
                      Value="@_nombreSocio"
                      ValueChanged="OnBusquedaChanged" />
        <FiltrosDesplegables Filtros="_definicionesFiltros"
                             VisiblesIniciales="_visiblesIniciales"
                             ConteoAplicados="ConteoAplicados"
                             VisiblesChanged="OnVisiblesChangedAsync" />
        @if (_showSede && _sedes.Count > 1 && _filtrosVisibles.Contains("sede"))
        {
            <MudSelect T="long"
                       Label="Sede"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       OuterClass="filter-field"
                       RelativeWidth="DropdownWidth.Adaptive"
                       Value="_sedeSeleccionada"
                       ValueChanged="OnSedeChangedAsync">
                <MudSelectItem Value="@SedeFiltroTodas">Todas las sedes</MudSelectItem>
                @foreach (var sede in _sedes)
                {
                    <MudSelectItem Value="@sede.IdSede">@sede.Nombre</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_filtrosVisibles.Contains("estado"))
        {
            <MudSelect T="string"
                       OuterClass="filter-field"
                       RelativeWidth="DropdownWidth.Adaptive"
                       Label="Estado"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Value="@_filtroEstado"
                       ValueChanged="OnFiltroEstadoChangedAsync">
                <MudSelectItem Value="@("")">Todos</MudSelectItem>
                <MudSelectItem Value="@MembresiaEstados.Activa">@EtiquetaEstado(MembresiaEstados.Activa)</MudSelectItem>
                <MudSelectItem Value="@MembresiaEstados.Vencida">@EtiquetaEstado(MembresiaEstados.Vencida)</MudSelectItem>
                <MudSelectItem Value="@MembresiaEstados.Congelada">@EtiquetaEstado(MembresiaEstados.Congelada)</MudSelectItem>
                <MudSelectItem Value="@MembresiaEstados.Cancelada">@EtiquetaEstado(MembresiaEstados.Cancelada)</MudSelectItem>
            </MudSelect>
        }
        @if (_filtrosVisibles.Contains("plan"))
        {
            <MudSelect T="long?"
                       Label="Plan"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Value="_idPlan"
                       ValueChanged="OnPlanFiltroChangedAsync">
                <MudSelectItem T="long?" Value="null">Todos</MudSelectItem>
                @foreach (var plan in _planes)
                {
                    <MudSelectItem Value="@((long?)plan.IdPlan)">@plan.Nombre</MudSelectItem>
                }
            </MudSelect>
        }
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th class="col-socio">Socio</th>
                    <th>Plan</th>
                    <th>Inicio</th>
                    <th>Fin</th>
                    <th class="col-accion">Estado</th>
                    <th class="col-accion" style="width: 56px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_cargando)
                {
                    <tr><td colspan="6" class="empty-cell">Cargando...</td></tr>
                }
                else if (_filas.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-cell">
                            @(_nombreSocio.Trim().Length > 0 || _filtroEstado.Length > 0 || _idPlan is not null
                                ? "Sin resultados para los filtros aplicados"
                                : "No hay membresías registradas en esta sede")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var f in _filas)
                    {
                        <tr>
                            <td class="col-socio"><strong>@f.NombreSocio</strong></td>
                            <td>@f.PlanNombre</td>
                            <td class="muted-cell">@FormatearFecha(f.FechaInicio)</td>
                            <td class="muted-cell">@FormatearFecha(f.FechaFin)</td>
                            <td class="col-accion">
                                <span class="status-badge @ClaseEstado(f.EstadoEfectivo)">@EtiquetaEstado(f.EstadoEfectivo)</span>
                            </td>
                            <td class="col-accion">
                                <MudMenu Open="@EsMenuAbierto(f.IdMembresia)" OpenChanged="@(v => MenuOpenChanged(f.IdMembresia, v))" AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight"
                                         Class="row-menu">
                                    <ActivatorContent>
                                        @* MudBlazor v9: ToggleAsync explícito (breaking change v9). *@<span class="morph-toggle @(EsMenuAbierto(f.IdMembresia) ? "abierto" : "")"

                                        @onclick="@context.ToggleAsync"

                                        role="button" tabindex="0" aria-label="Acciones"><svg class="morph-more" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2.2"/><circle cx="12" cy="12" r="2.2"/><circle cx="12" cy="19" r="2.2"/></svg><svg class="morph-close" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.41 13.41 12z"/></svg></span>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick='() => AbrirDetalle(f)'>
                                            <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" /> Ver detalle / Gestionar
                                        </MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_filas.Count > 0)
    {
        <div class="table-footer">
            <span class="muted">Mostrando @_filas.Count de @_totalRegistros membresía(s)</span>
            <div class="pagination-controls">
                <MudSelect T="int"
                           Label="Ver"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           OuterClass="page-size-field"
                           RelativeWidth="DropdownWidth.Adaptive"
                           Value="_tamanoPagina"
                           ValueChanged="OnTamanoPaginaChangedAsync">
                    @foreach (var tamano in TamanosPagina.Validos)
                    {
                        <MudSelectItem Value="@tamano">@tamano</MudSelectItem>
                    }
                </MudSelect>
                @if (_totalPaginas > 1)
                {
                    <MudPagination Count="_totalPaginas"
                                   Selected="_pagina"
                                   SelectedChanged="OnPaginaChangedAsync"
                                   Color="Color.Primary"
                                   Size="Size.Small" />
                }
            </div>
        </div>
    }
</div>

@if (_ventaAbierta)
{
    <VenderMembresiaDialog Open="true"
                           OnClose="CerrarVenta"
                           OnSaved="RecargarDespuesDeGuardar" />
}

@if (_detalleAbierto && _socioDetalle is not null)
{
    <SocioMembresiasDialog Open="true"
                           Socio="_socioDetalle"
                           OnClose="CerrarDetalle"
                           OnChanged="RecargarDespuesDeGuardar" />
}

@code {
    // Estado del menu de fila con morfeo: guarda el ID de la fila cuyo menu esta abierto (null = ninguno).
    // Se alimenta de MudMenu.OpenChanged (dispara por TODOS los caminos de cierre: item, backdrop, Escape).
    private string? _menuAbiertoId;

    private bool EsMenuAbierto(object? idFila) => idFila is not null && _menuAbiertoId == idFila.ToString();

    private void MenuOpenChanged(object? idFila, bool abierto) =>
        _menuAbiertoId = abierto
            ? idFila?.ToString()
            : (_menuAbiertoId == idFila?.ToString() ? null : _menuAbiertoId);

    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private IMembresiasService Membresias { get; set; } = default!;
    [Inject] private IPlanesMembresiaService Planes { get; set; } = default!;
    [Inject] private IAuthorizationService Authz { get; set; } = default!;
    [Inject] private ISedesRepository Sedes { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;
    [Inject] private ITerminalConfigStore Terminal { get; set; } = default!;

    private bool _tienePermiso;
    private bool _cargando;
    private string _nombreSocio = "";
    private string _filtroEstado = "";
    private long? _idPlan;
    private CancellationTokenSource? _debounce;

    // FiltrosDesplegables: catálogo declarativo + visibilidad en memoria.
    // Default razonable: Estado visible; Plan y Sede ocultos hasta que se pidan.
    private readonly List<FiltrosDesplegables.FiltroDefinicion> _definicionesFiltros = new()
    {
        new("estado", "Estado"),
        new("plan", "Plan"),
        new("sede", "Sede"),
    };
    private static readonly string[] _visiblesIniciales = ["estado"];
    private HashSet<string> _filtrosVisibles = ["estado"];

    private int ConteoAplicados =>
        (_filtroEstado.Length > 0 ? 1 : 0)
        + (_idPlan is not null ? 1 : 0)
        + (_showSede && _filtrosVisibles.Contains("sede") && _sedeSeleccionada > 0 ? 1 : 0);

    /// <summary>Al ocultar un filtro se limpia su valor: nunca queda un filtro
    /// invisible pero aplicado silenciosamente.</summary>
    private async Task OnVisiblesChangedAsync(IReadOnlyList<string> visibles)
    {
        _filtrosVisibles = visibles.ToHashSet(StringComparer.Ordinal);
        if (!_filtrosVisibles.Contains("estado"))
        {
            _filtroEstado = "";
        }
        if (!_filtrosVisibles.Contains("plan"))
        {
            _idPlan = null;
        }
        if (!_filtrosVisibles.Contains("sede"))
        {
            _sedeSeleccionada = 0;
        }
        _pagina = 1;
        await CargarAsync();
    }

    private bool _showSede;
    private long _sedeSeleccionada;

    /// <summary>0 = "Todas las sedes" (no se envía idSede al servicio).</summary>
    private const long SedeFiltroTodas = 0;
    private List<Sede> _sedes = [];
    private List<PlanMembresia> _planes = [];

    private List<MembresiaListadoDto> _filas = [];
    private int _pagina = 1;
    private int _tamanoPagina = TamanosPagina.Default;
    private int _totalRegistros;
    private int _totalPaginas;

    private bool _ventaAbierta;

    // Detalle: abre el historial/gestión de TODAS las membresías del socio
    // de esa fila (congelar/cancelar viven allí con su reautorización).
    private bool _detalleAbierto;
    private Socio? _socioDetalle;

    protected override async Task OnInitializedAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        try
        {
            await Authz.RequierePermisoAsync(sesion.Token, PermisoCatalogo.MembresiasVer);
            _tienePermiso = true;
        }
        catch (BusinessException)
        {
            Feedback.ShowError("No tienes permiso para ver las membresías");
            return;
        }

        _showSede = sesion.IdSede is null;
        if (_showSede)
        {
            try
            {
                _sedes = (await Sedes.GetActivasAsync()).ToList();
            }
            catch
            {
                _sedes = [];
            }

            // Preselección al encender el filtro: la sede de ESTA terminal
            // (mismo mecanismo del Kiosco) si está configurada; si no, "Todas".
            var idSedeTerminal = await Terminal.ObtenerIdSedeAsync();
            _sedeSeleccionada = idSedeTerminal is not null && _sedes.Any(s => s.IdSede == idSedeTerminal.Value)
                ? idSedeTerminal.Value
                : SedeFiltroTodas;
        }

        await CargarAsync();
    }

    public void Dispose() => _debounce?.Cancel();

    /// <summary>Búsqueda con debounce de 300ms (patrón Miembros/Productos/Maquinaria).</summary>
    private async Task OnBusquedaChanged(string value)
    {
        _nombreSocio = value;
        _pagina = 1;
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
            await CargarAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnFiltroEstadoChangedAsync(string value)
    {
        _filtroEstado = value ?? "";
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnPlanFiltroChangedAsync(long? value)
    {
        _idPlan = value == 0 ? null : value;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnTamanoPaginaChangedAsync(int value)
    {
        _tamanoPagina = value;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnPaginaChangedAsync(int value)
    {
        _pagina = value;
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null || !_tienePermiso)
        {
            return;
        }

        _cargando = true;
        try
        {
            var resultado = await Membresias.BuscarAsync(
                sesion.Token,
                string.IsNullOrWhiteSpace(_nombreSocio) ? null : _nombreSocio.Trim(),
                _filtroEstado.Length > 0 ? _filtroEstado : null,
                _idPlan,
                _pagina,
                _tamanoPagina,
                _showSede && _filtrosVisibles.Contains("sede") && _sedeSeleccionada > 0
                    ? _sedeSeleccionada
                    : null);
            _filas = resultado.Items.ToList();
            _totalRegistros = resultado.TotalRegistros;
            _totalPaginas = resultado.TotalPaginas;
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo cargar el listado");
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private async Task OnSedeChangedAsync(long value)
    {
        _sedeSeleccionada = value;
        await CargarAsync();
    }

    private void AbrirVenta() => _ventaAbierta = true;

    private void CerrarVenta() => _ventaAbierta = false;

    private void AbrirDetalle(MembresiaListadoDto fila)
    {
        _socioDetalle = new Socio
        {
            IdSocio = fila.IdSocio,
            Nombre = fila.NombreSocio,
        };
        _detalleAbierto = true;
    }

    private void CerrarDetalle() => _detalleAbierto = false;

    private async Task RecargarDespuesDeGuardar() => await CargarAsync();

    private static string ClaseEstado(string estado) => estado switch
    {
        MembresiaEstados.Activa => "status-success",
        MembresiaEstados.Vencida => "status-danger",
        MembresiaEstados.Congelada => "status-warning",
        MembresiaEstados.Cancelada => "status-danger",
        _ => "status-info",
    };

    private static string EtiquetaEstado(string estado) => estado switch
    {
        MembresiaEstados.Activa => "Activa",
        MembresiaEstados.Vencida => "Vencida",
        MembresiaEstados.Congelada => "Congelada",
        MembresiaEstados.Cancelada => "Cancelada",
        _ => estado,
    };

    private static string FormatearFecha(string? iso)
    {
        if (string.IsNullOrWhiteSpace(iso))
        {
            return "—";
        }
        if (DateTimeOffset.TryParse(iso, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var dto))
        {
            return dto.ToLocalTime().ToString("dd/MM/yyyy", CultureInfo.GetCultureInfo("es-MX"));
        }
        return iso;
    }
}
