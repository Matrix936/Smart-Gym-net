@page "/mi-perfil"
@* MiPerfilPage: datos y contraseña del USUARIO LOGUEADO (no un módulo del
   gimnasio). Navegación por secciones (menu lateral, mismo patrón sg-nav-item
   del sidebar) — solo una sección visible a la vez. Acciones independientes
   con submits separados: nunca mezclar perfil y contraseña en un mismo envío.
   EditarPerfilAsync refresca la sesión en memoria, así que el nombre cambia en
   toda la app sin re-login. AMBAS acciones exigen reautenticación al final
   (mismo criterio que CancelarVenta/cierre de caja): la contraseña vigente se
   pide en un dialogo aparte para que quede claro QUE se esta confirmando. *@
@using System.ComponentModel.DataAnnotations
@using MudBlazor
@using SmartGym.Core.Entities
@using SmartGym.Core.Repositories
@using SmartGym.Core.Services
@using SmartGym.App.Services

<div class="page-head">
    <div>
        <h4>Mi Perfil</h4>
        <p class="page-sub">Datos de tu cuenta de usuario.</p>
    </div>
</div>

<div style="display: flex; gap: 1rem; align-items: flex-start;">
    @* Sin glass-panel/blur: dos capas backdrop-filter adyacentes + transiciones
       de hover provocaban parpadeo en WebView2 (ver subnav.css). *@
    <div class="sg-page-subnav">
        @* Mismo patrón del sidebar (NavMenu): div.sg-nav-item, no <button>
           (el fondo nativo del button asomaba como un rectángulo gris que
           parpadeaba con el hover sobre el blur del panel). *@
        <div class="sg-nav-item @(_seccion == SeccionPerfil.Datos ? "active" : null)"
             style="width: 100%;"
             @onclick="IrADatos"
             @onkeydown='e => SeccionKeyDown(e, SeccionPerfil.Datos)'
             role="button" tabindex="0"
             aria-current="@(_seccion == SeccionPerfil.Datos ? "true" : null)">
            <span class="sg-nav-item-indicator"></span>
            <span class="sg-nav-item-label">Datos generales</span>
        </div>
        <div class="sg-nav-item @(_seccion == SeccionPerfil.Password ? "active" : null)"
             style="width: 100%;"
             @onclick="IrAPassword"
             @onkeydown='e => SeccionKeyDown(e, SeccionPerfil.Password)'
             role="button" tabindex="0"
             aria-current="@(_seccion == SeccionPerfil.Password ? "true" : null)">
            <span class="sg-nav-item-indicator"></span>
            <span class="sg-nav-item-label">Contraseña</span>
        </div>
    </div>

    @if (_seccion == SeccionPerfil.Datos)
    {
        <div class="glass-panel" style="flex: 1; min-width: 0;">
            <p class="form-section">Datos generales</p>
            <div class="form-fields" style="max-width: 480px;" @onkeydown="HandlePerfilKeyDown">
                <MudTextField T="string" Label="Nombre *" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" @bind-Value="_nombre" />
                <div class="form-row">
                    <MudTextField T="string" Label="Apellido paterno" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" @bind-Value="_apellidoPaterno" />
                    <MudTextField T="string" Label="Apellido materno" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Immediate="true" @bind-Value="_apellidoMaterno" />
                </div>
                <MudTextField T="string" Label="Email *" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Immediate="true" @bind-Value="_email" />
                <div style="margin-top: 0.75rem;">
                    <AsyncButton Text="Guardar datos"
                                 LoadingText="Guardando..."
                                 IsLoading="_guardandoPerfil"
                                 OnClick="SolicitarGuardadoAsync" />
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="glass-panel" style="flex: 1; min-width: 0;">
            <p class="form-section">Cambiar contraseña</p>
            @* Sin campo de contraseña actual: igual que Datos generales, la
               clave vigente se pide al final en el dialogo de confirmación
               (CambiarPasswordAsync la usa para su propia reautorización). *@
            <div class="form-fields" style="max-width: 480px;" @onkeydown="HandlePasswordKeyDown">
                <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                    <div style="flex: 1;">
                        <PasswordField Label="Nueva contraseña * (mínimo 8 caracteres)" Autocomplete="new-password" @bind-Value="_passwordNueva" />
                    </div>
                    <div style="flex: 1;">
                        <PasswordField Label="Confirmar nueva contraseña *" Autocomplete="new-password" @bind-Value="_passwordConfirmar" />
                    </div>
                </div>
                <div style="margin-top: 0.75rem;">
                    <AsyncButton Text="Cambiar contraseña"
                                 LoadingText="Cambiando..."
                                 IsLoading="_cambiandoPassword"
                                 OnClick="SolicitarCambioPasswordAsync" />
                </div>
            </div>
        </div>
    }
</div>

<MudDialog Visible="_reauthAbierto"
           VisibleChanged="OnReauthVisibleChanged"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Confirmar cambios</MudText>
    </TitleContent>
    <DialogContent>
        @* Reautenticación real (no un PIN aparte): confirma que quien guarda
           (datos o cambio de contraseña) sabe la contraseña vigente, mismo
           criterio que CancelarVenta/cierre de caja. Un solo dialogo para las
           dos acciones de la página. *@
        <div @onkeydown="HandleReauthKeyDown">
            <p class="muted" style="margin-bottom: 0.5rem;">Ingresa tu contraseña actual para confirmar el cambio.</p>
            <PasswordField Label="Contraseña actual *" Autocomplete="current-password" @bind-Value="_reauthPassword" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_reautenticando" OnClick="CancelarReauth">Cancelar</MudButton>
        <AsyncButton Text="Confirmar y guardar" LoadingText="Verificando..." IsLoading="_reautenticando" OnClick="ConfirmarReauthAsync" />
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private IAuthService Auth { get; set; } = default!;
    [Inject] private IUsuariosRepository UsuariosRepo { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;

    private enum SeccionPerfil { Datos, Password }

    private SeccionPerfil _seccion = SeccionPerfil.Datos;

    private string _nombre = "";
    private string _apellidoPaterno = "";
    private string _apellidoMaterno = "";
    private string _email = "";
    private bool _guardandoPerfil;

    private string _passwordNueva = "";
    private string _passwordConfirmar = "";
    private bool _cambiandoPassword;

    // Reautenticación compartida por las dos acciones (datos generales y
    // contraseña): la clave vigente se pide al final, no en los formularios.
    private enum AccionReauth { Perfil, Password }

    private AccionReauth _reauthAccion = AccionReauth.Perfil;
    private bool _reauthAbierto;
    private bool _reautenticando;
    private string _reauthPassword = "";

    protected override async Task OnInitializedAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        // Prefill desde DB (los apellidos no viven en SessionInfo).
        var usuario = await UsuariosRepo.GetByIdAsync(sesion.IdUsuario);
        if (usuario is not null)
        {
            _nombre = usuario.Nombre;
            _apellidoPaterno = usuario.ApellidoPaterno ?? "";
            _apellidoMaterno = usuario.ApellidoMaterno ?? "";
            _email = usuario.Email;
        }
        else
        {
            _nombre = sesion.Nombre;
            _email = sesion.Email;
        }
    }

    private void IrADatos()
    {
        if (!_guardandoPerfil)
        {
            _seccion = SeccionPerfil.Datos;
        }
    }

    private void IrAPassword()
    {
        if (!_guardandoPerfil)
        {
            _seccion = SeccionPerfil.Password;
        }
    }

    /// <summary>Los div role=button no disparan click con teclado: Enter/Espacio activan la sección.</summary>
    private void SeccionKeyDown(KeyboardEventArgs e, SeccionPerfil seccion)
    {
        if (e.Key is "Enter" or " ")
        {
            if (seccion == SeccionPerfil.Datos)
            {
                IrADatos();
            }
            else
            {
                IrAPassword();
            }
        }
    }

    private void HandlePerfilKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_guardandoPerfil)
        {
            _ = SolicitarGuardadoAsync();
        }
        else if (e.Key == "Escape")
        {
            _ = CerrarEdicion();
        }
    }

    /// <summary>Vuelve a leer los valores guardados para descartar ediciones.</summary>
    private async Task CerrarEdicion()
    {
        if (_guardandoPerfil)
        {
            return;
        }
        await OnInitializedAsync();
    }

    /// <summary>Valida los campos de datos generales y abre el dialogo. No guarda nada todavía.</summary>
    private Task SolicitarGuardadoAsync()
    {
        if (string.IsNullOrWhiteSpace(_nombre))
        {
            Feedback.ShowWarning("Ingresa tu nombre");
            return Task.CompletedTask;
        }
        if (string.IsNullOrWhiteSpace(_email))
        {
            Feedback.ShowWarning("Ingresa tu email");
            return Task.CompletedTask;
        }

        AbrirReauth(AccionReauth.Perfil);
        return Task.CompletedTask;
    }

    private void HandleReauthKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_reautenticando)
        {
            _ = ConfirmarReauthAsync();
        }
    }

    private void CancelarReauth() => _reauthAbierto = false;

    private void OnReauthVisibleChanged(bool visible)
    {
        _reauthAbierto = visible;
    }

    private void AbrirReauth(AccionReauth accion)
    {
        _reauthAccion = accion;
        _reauthPassword = "";
        _reauthAbierto = true;
    }

    /// <summary>Reautoriza y recién entonces ejecuta la acción pendiente (perfil o contraseña). Si la clave es incorrecta no guarda nada.</summary>
    private async Task ConfirmarReauthAsync()
    {
        if (_reautenticando || Sesion.Current is null)
        {
            return;
        }

        if (string.IsNullOrEmpty(_reauthPassword))
        {
            Feedback.ShowWarning("Ingresa tu contraseña actual");
            return;
        }

        _reautenticando = true;
        try
        {
            if (_reauthAccion == AccionReauth.Perfil)
            {
                await GuardarPerfilAsync();
            }
            else
            {
                await CambiarPasswordAsync();
            }
            _reauthAbierto = false;
        }
        finally
        {
            _reautenticando = false;
        }
    }

    /// <summary>Precondición: reautorización ya hecha. Refresca la sesión con el perfil actualizado.</summary>
    private async Task GuardarPerfilAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null || _guardandoPerfil)
        {
            return;
        }

        _guardandoPerfil = true;
        try
        {
            await Auth.ReautorizarAsync(sesion.Token, _reauthPassword);
            var actualizada = await Auth.EditarPerfilAsync(
                sesion.Token,
                _nombre.Trim(),
                _apellidoPaterno?.Trim(),
                _apellidoMaterno?.Trim(),
                _email.Trim());
            Feedback.ShowSuccess("Datos actualizados");
            // Refresca el token en sesión con la info fresca (mismo token).
            Sesion.Login(actualizada);
            StateHasChanged();
        }
        catch (BusinessException ex)
        {
            // Incluye "Clave incorrecta" de ReautorizarAsync: el dialogo queda
            // abierto y no se guardó nada.
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo actualizar tu perfil");
        }
        finally
        {
            _guardandoPerfil = false;
        }
    }

    private void HandlePasswordKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_cambiandoPassword)
        {
            SolicitarCambioPasswordAsync();
        }
        else if (e.Key == "Escape")
        {
            // Descarta la edición: limpia los campos y vuelve a leer lo guardado
            // (mismo criterio que la sección Datos generales).
            _ = DescartarCambioPasswordAsync();
        }
    }

    private async Task DescartarCambioPasswordAsync()
    {
        if (_cambiandoPassword)
        {
            return;
        }
        _passwordNueva = "";
        _passwordConfirmar = "";
        await CerrarEdicion();
    }

    /// <summary>Valida la nueva contraseña y abre el dialogo de reautenticación. No cambia nada todavía.</summary>
    private void SolicitarCambioPasswordAsync()
    {
        if (string.IsNullOrEmpty(_passwordNueva) || _passwordNueva.Length < 8)
        {
            Feedback.ShowWarning("La nueva contraseña debe tener al menos 8 caracteres");
            return;
        }
        if (_passwordNueva != _passwordConfirmar)
        {
            Feedback.ShowWarning("La confirmación no coincide con la nueva contraseña");
            return;
        }

        AbrirReauth(AccionReauth.Password);
    }

    /// <summary>Precondición: reautorización ya hecha (la contraseña vigente llega en _reauthPassword).</summary>
    private async Task CambiarPasswordAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null || _cambiandoPassword)
        {
            return;
        }

        _cambiandoPassword = true;
        try
        {
            await Auth.CambiarPasswordAsync(
                sesion.Token, _reauthPassword, _passwordNueva);
            Feedback.ShowSuccess("Contraseña cambiada");
            _passwordNueva = "";
            _passwordConfirmar = "";
            StateHasChanged();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo cambiar la contraseña");
        }
        finally
        {
            _cambiandoPassword = false;
        }
    }
}
