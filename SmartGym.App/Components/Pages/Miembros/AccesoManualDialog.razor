@* AccesoManualDialog (ManualAccessDialog.tsx): entrada manual (forzar acceso) con resultado y motivo de denegación. *@
@using MudBlazor
@using SmartGym.Core.Common
@using SmartGym.Core.Entities
@using SmartGym.Core.Repositories
@using SmartGym.Core.Services
@using SmartGym.App.Services

<MudDialog @ref="_mudDialog" Visible="_visible"
           VisibleChanged="OnVisibleChanged"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Forzar acceso</MudText>
    </TitleContent>
    <DialogContent>
        <div style="margin-top: 0.5rem;" @onkeydown="HandleKeyDown">
            <div class="access-result access-alert-info">
                Marcar manualmente la entrada de <strong>@NombreCompleto</strong>.
                Si la membresía está vencida o el socio bloqueado, se registrará el acceso como <strong>denegado</strong>.
            </div>

            @if (_showSede)
            {
                <div class="form-fields" style="margin-top: 1rem;">
                    <MudSelect T="long"
                               Label="Sede *"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               @bind-Value="_idSede">
                        @foreach (var sede in _sedes)
                        {
                            <MudSelectItem Value="@sede.IdSede">@sede.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </div>
            }

            @if (_resultado is not null)
            {
                <div class="access-result @(_resultado.Estado == AccesoEstados.Concedido ? "access-result-ok" : "access-result-ko")"
                     style="margin-top: 1rem;">
                    <strong>@(_resultado.Estado == AccesoEstados.Concedido ? "Acceso registrado correctamente" : "Acceso denegado")</strong>
                    @if (_resultado.Estado == AccesoEstados.Denegado)
                    {
                        <div style="margin-top: 0.25rem;">@MotivoLabel(_resultado.MotivoDenegacion)</div>
                    }
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_guardando" OnClick="Cancelar">Cerrar</MudButton>
        <AsyncButton Text="Registrar acceso"
                     LoadingText="Registrando..."
                     IsLoading="_guardando"
                     Disabled="_resultado is not null"
                     OnClick="RegistrarAsync" />
    </DialogActions>
</MudDialog>

@code {
    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private IAccesoService Acceso { get; set; } = default!;
    [Inject] private ISedesRepository Sedes { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;

    [Parameter] public bool Open { get; set; }
    [Parameter] public Socio? Socio { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private bool _showSede;
    private List<Sede> _sedes = [];
    private long _idSede;
    private AccesoResult? _resultado;
    private bool _guardando;
    private bool _visible;
    private MudDialog _mudDialog = default!;

    protected override async Task OnInitializedAsync()
    {
        _visible = Open;
        _showSede = Sesion.Current?.IdSede is null;
        if (_showSede)
        {
            try
            {
                _sedes = (await Sedes.GetActivasAsync()).ToList();
            }
            catch
            {
                _sedes = [];
            }
            try
            {
                var principal = await Sedes.GetPrincipalAsync();
                _idSede = principal?.IdSede ?? _sedes.FirstOrDefault()?.IdSede ?? 0;
            }
            catch
            {
                _idSede = _sedes.FirstOrDefault()?.IdSede ?? 0;
            }
        }
    }

    private async Task OnVisibleChanged(bool visible)
    {
        _visible = visible;
        if (!visible)
        {
            await OnClose.InvokeAsync();
        }
    }

    private Task Cancelar() => _mudDialog.CloseAsync();

    /// <summary>Enter registra el acceso (mientras no haya resultado mostrado);
    /// Escape cierra el diálogo (nativo vía CloseOnEscapeKey, rama explícita
    /// por consistencia con el resto de formularios).</summary>
    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (_guardando)
        {
            return;
        }
        if (e.Key == "Enter" && _resultado is null)
        {
            _ = RegistrarAsync();
        }
        else if (e.Key == "Escape")
        {
            _ = Cancelar();
        }
    }

    private async Task RegistrarAsync()
    {
        if (_showSede && _idSede <= 0)
        {
            Feedback.ShowWarning("Selecciona la sede");
            return;
        }

        var sesion = Sesion.Current!;
        _guardando = true;
        try
        {
            var idSede = _showSede ? _idSede : sesion.IdSede!.Value;
            _resultado = await Acceso.RegistrarAccesoManualAsync(sesion.Token, Socio!.IdSocio, idSede);
            if (_resultado.Estado == AccesoEstados.Concedido)
            {
                Feedback.ShowSuccess("Acceso concedido");
            }
            else
            {
                Feedback.ShowError(MotivoLabel(_resultado.MotivoDenegacion) ?? "Acceso denegado");
            }
            await OnSaved.InvokeAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo registrar el acceso");
        }
        finally
        {
            _guardando = false;
        }
    }

    private string NombreCompleto =>
        string.Join(" ", new[] { Socio?.Nombre, Socio?.ApellidoPaterno, Socio?.ApellidoMaterno }
            .Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string? MotivoLabel(string? motivo) => motivo switch
    {
        "socio_bloqueado" => "Socio bloqueado. Contacte a recepción.",
        "socio_inactivo" => "Socio inactivo. Contacte a recepción.",
        "membresia_vencida" => "Membresía vencida. Renueve para acceder.",
        "membresia_congelada" => "Membresía congelada. No permite acceso.",
        _ => motivo,
    };
}