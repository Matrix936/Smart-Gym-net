@* FingerprintEnrollDialog (FingerprintEnrollDialog.tsx): enrolamiento de huella conectado a
   IBiometricCaptureService. Mismo patrón estructural que MiembroFormDialog/AccesoManualDialog
   (MudDialog inline, no IDialogService) para heredar el comportamiento ya validado de
   Escape/z-index (ver Bloque 2: docs/migracion-dotnet/08-problemas-resueltos-blazor.md §6). *@
@implements IDisposable
@using MudBlazor
@using SmartGym.Core.Biometrics
@using SmartGym.Core.Entities
@using SmartGym.Core.Repositories
@using SmartGym.App.Services

<MudDialog @ref="_mudDialog" Visible="_visible"
           VisibleChanged="OnVisibleChanged"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">
            <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Small" Class="sg-user-item-icon" />
            @(TieneHuella ? "Reemplazar huella" : "Registrar huella") — @NombreCompleto
        </MudText>
    </TitleContent>
    <DialogContent>
        <div style="margin-top: 0.5rem;">
            @if (_capturando || _resultado is ResultadoVisual.Completado or ResultadoVisual.Error)
            {
                @* Silueta de huella con relleno progresivo (clip-path) según las
                   muestras; completado/error reutilizan los keyframes del Kiosco.
                   El estado llega por EnrollmentStatusChanged (InvokeAsync). *@
                <div class="huella-captura @ClaseHuella">
                    <div class="huella-captura-icono">
                        <div class="huella-capa huella-capa-base">@((MarkupString)HuellaSvg)</div>
                        <div class="huella-capa huella-capa-relleno" style="@EstiloRelleno">@((MarkupString)HuellaSvg)</div>
                    </div>
                    @if (_capturando)
                    {
                        <p class="huella-contador">Muestra @_muestrasCapturadas de @_muestrasRequeridas</p>
                        <p class="muted" style="margin: 0;">@EstadoLabel()</p>
                    }
                </div>
            }

            @if (_capturando && _ultimaEtapa == EnrollmentStage.EsperandoDedo && _muestrasCapturadas == 0)
            {
                <div class="access-result access-alert-info" style="margin-top: 1rem;">
                    Sigue las instrucciones del lector biométrico
                </div>
            }
            else if (_ultimoError is not null && _resultado != ResultadoVisual.Error)
            {
                <div class="access-result access-result-ko" style="margin-top: 1rem;">@_ultimoError</div>
            }

            @if (_resultado == ResultadoVisual.Error && _ultimoError is not null)
            {
                <div class="access-result access-result-ko" style="margin-top: 1rem;">@_ultimoError</div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancelar">Cancelar</MudButton>
        @if (!_capturando)
        {
            <AsyncButton Text="Iniciar captura"
                         LoadingText="Iniciando..."
                         Disabled="@(CaptureService.CurrentMode == BiometricCaptureMode.Enrolling)"
                         OnClick="IniciarCapturaAsync" />
        }
    </DialogActions>
</MudDialog>

<ConfirmDialog IsOpen="_confirmarReemplazo"
               Titulo="Reemplazar huella"
               Mensaje="Este socio ya tiene una huella registrada. Si continúas, la huella anterior dejará de funcionar hasta completar el nuevo registro. ¿Deseas continuar?"
               TextoConfirmar="Continuar"
               OnConfirm="ConfirmarReemplazoAsync"
               OnCancel="CancelarReemplazo" />

@code {
    [Inject] private IBiometricCaptureService CaptureService { get; set; } = default!;
    [Inject] private ISociosBiometricosRepository Biometricos { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;

    [Parameter] public bool Open { get; set; }
    [Parameter] public Socio? Socio { get; set; }
    [Parameter] public bool TieneHuella { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    // Un socio tiene una sola huella activa (decisión de producto): no hay
    // selección de dedo, el valor es fijo.
    private const string DedoPrincipal = "principal";

    /// <summary>Estado visual del resultado sobre la silueta (relleno congelado + animación).</summary>
    private enum ResultadoVisual { Ninguno, Completado, Error }

    private ResultadoVisual _resultado = ResultadoVisual.Ninguno;

    private string ClaseHuella => _resultado switch
    {
        ResultadoVisual.Completado => "completado",
        ResultadoVisual.Error => "error",
        _ => "",
    };

    /// <summary>Clip del relleno: abajo → arriba, 0% de muestra = tapado al 100%.</summary>
    private string EstiloRelleno
    {
        get
        {
            var pct = _muestrasRequeridas == 0
                ? 0
                : Math.Clamp(_muestrasCapturadas * 100 / _muestrasRequeridas, 0, 100);
            if (_resultado == ResultadoVisual.Completado)
            {
                pct = 100;
            }
            return $"clip-path: inset({100 - pct}% 0 0 0);";
        }
    }

    /// <summary>
    /// Huella estilizada como arcos concéntricos (whorl), trazo coherente con el
    /// set Solar (stroke currentColor). Se dibuja dos veces: base tenue + capa de
    /// relleno recortada por clip-path según las muestras capturadas.
    /// </summary>
    private const string HuellaSvg = """
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round">
            <path d="M6,34 A18,18 0 1 1 42,34" />
            <path d="M11,34 A13,13 0 1 1 37,34" opacity=".85" />
            <path d="M15.5,34 A8.5,8.5 0 1 1 32.5,34" opacity=".7" />
            <path d="M19.5,34 A4.5,4.5 0 1 1 28.5,34" opacity=".55" />
            <circle cx="24" cy="32.5" r="1.6" fill="currentColor" stroke="none" />
        </svg>
        """;

    private bool _visible;
    private MudDialog _mudDialog = default!;
    private bool _capturando;
    private bool _confirmarReemplazo;
    private string? _ultimoError;
    private EnrollmentStage _ultimaEtapa = EnrollmentStage.EsperandoDedo;
    private int _muestrasCapturadas;
    private int _muestrasRequeridas = 4;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _visible = Open;
        CaptureService.EnrollmentStatusChanged += OnEnrollmentStatusChanged;
    }

    private async Task OnVisibleChanged(bool visible)
    {
        _visible = visible;
        if (!visible)
        {
            CancelarSiEnrolando();
            await OnClose.InvokeAsync();
        }
    }

    private Task Cancelar() => _mudDialog.CloseAsync();

    private void IniciarCapturaAsync()
    {
        if (TieneHuella)
        {
            _confirmarReemplazo = true;
            return;
        }
        _ = ComenzarCapturaAsync();
    }

    private void ConfirmarReemplazoAsync()
    {
        _confirmarReemplazo = false;
        _ = ComenzarCapturaAsync();
    }

    private void CancelarReemplazo() => _confirmarReemplazo = false;

    private async Task ComenzarCapturaAsync()
    {
        _ultimoError = null;
        _capturando = true;
        _resultado = ResultadoVisual.Ninguno;
        _muestrasCapturadas = 0;
        _muestrasRequeridas = 4;
        _ultimaEtapa = EnrollmentStage.EsperandoDedo;
        StateHasChanged();

        // Templates globales (sin filtro de sede) excluyendo los del socio
        // actual — re-enrolamiento no debe matchear contra sí mismo.
        List<string> templatesExistentes;
        try
        {
            var todos = await Biometricos.GetTodosLosTemplatesActivosAsync(Socio!.IdSocio);
            templatesExistentes = todos.ToList();
        }
        catch
        {
            templatesExistentes = [];
        }

        EnrollmentResult resultado;
        try
        {
            resultado = await CaptureService.StartEnrollmentAsync(
                Socio!.IdSocio, DedoPrincipal, 4, templatesExistentes);
        }
        catch (Exception ex)
        {
            if (_disposed)
            {
                return;
            }
            _capturando = false;
            _ultimoError = ex.Message;
            StateHasChanged();
            return;
        }

        if (_disposed)
        {
            return;
        }

        _capturando = false;

        switch (resultado.Estado)
        {
            case EnrollmentStage.Completado:
                // Celebración sobre la silueta antes de cerrar.
                _resultado = ResultadoVisual.Completado;
                try
                {
                    await Biometricos.RegistrarTemplateAsync(Socio!.IdSocio, DedoPrincipal, resultado.TemplatePath!);
                    Feedback.ShowSuccess("Huella registrada correctamente");
                    await OnSaved.InvokeAsync();
                    await Task.Delay(600);
                    await _mudDialog.CloseAsync();
                }
                catch
                {
                    _ultimoError = "Huella capturada pero no se pudo guardar el registro";
                    Feedback.ShowError(_ultimoError);
                    StateHasChanged();
                }
                break;

            case EnrollmentStage.Duplicado:
                _resultado = ResultadoVisual.Error; // relleno congelado + shake
                _ultimoError = "Esta huella ya est\u00e1 registrada para otro socio. Verifica con el titular o contacta al administrador.";
                Feedback.ShowError(_ultimoError);
                StateHasChanged();
                break;

            case EnrollmentStage.Error:
                _resultado = ResultadoVisual.Error;
                _ultimoError = resultado.Error ?? "Error durante el enrolamiento";
                Feedback.ShowError(_ultimoError);
                StateHasChanged();
                break;

            case EnrollmentStage.Cancelado:
                StateHasChanged();
                break;
        }
    }

    private void OnEnrollmentStatusChanged(object? sender, EnrollmentStatusEventArgs e)
    {
        // El SDK invoca este evento desde su propio hilo de mensajes, no el de
        // Blazor — InvokeAsync es obligatorio antes de tocar el estado del
        // componente (mismo criterio documentado en BiometricCaptureService).
        _ = InvokeAsync(() =>
        {
            if (_disposed)
            {
                return;
            }
            _ultimaEtapa = e.Estado;
            _muestrasCapturadas = e.MuestrasCapturadas;
            _muestrasRequeridas = e.MuestrasRequeridas;
            StateHasChanged();
        });
    }

    private string EstadoLabel() => _ultimaEtapa switch
    {
        EnrollmentStage.EsperandoDedo => "Coloca el dedo en el lector...",
        EnrollmentStage.Capturando => $"Capturando... ({_muestrasCapturadas} de {_muestrasRequeridas})",
        EnrollmentStage.Completado => "¡Huella registrada!",
        EnrollmentStage.Error => "Error durante el enrolamiento",
        EnrollmentStage.Cancelado => "Captura cancelada",
        _ => "",
    };

    private void CancelarSiEnrolando()
    {
        if (CaptureService.CurrentMode == BiometricCaptureMode.Enrolling)
        {
            CaptureService.CancelEnrollment();
        }
    }

    private string NombreCompleto =>
        string.Join(" ", new[] { Socio?.Nombre, Socio?.ApellidoPaterno, Socio?.ApellidoMaterno }
            .Where(x => !string.IsNullOrWhiteSpace(x)));

    public void Dispose()
    {
        _disposed = true;
        CaptureService.EnrollmentStatusChanged -= OnEnrollmentStatusChanged;
        CancelarSiEnrolando();
    }
}
