@* MiembroFormDialog (MemberFormDialog.tsx): alta/edición de socio con selector de sede para SUPERADMIN. *@
@using System.Globalization
@using MudBlazor
@using SmartGym.Core.Common
@using SmartGym.Core.Entities
@using SmartGym.Core.Repositories
@using SmartGym.Core.Services
@using SmartGym.App.Services

<MudDialog @ref="_mudDialog" Visible="_visible"
           VisibleChanged="OnVisibleChanged"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(Mode == "crear" ? "Nuevo miembro" : "Editar miembro")</MudText>
    </TitleContent>
    <DialogContent>
        <div style="margin-top: 0.5rem;">
            <p class="form-section">Datos generales</p>

            <MudTextField T="string" Label="Nombre *" Margin="Margin.Dense" Variant="Variant.Outlined"
                          @bind-Value="_form.Nombre" />
            <MudTextField T="string" Label="Apellido paterno *" Margin="Margin.Dense" Variant="Variant.Outlined"
                          @bind-Value="_form.ApellidoPaterno" />
            <MudTextField T="string" Label="Apellido materno" Margin="Margin.Dense" Variant="Variant.Outlined"
                          @bind-Value="_form.ApellidoMaterno" />

            <div class="form-row">
                <MudTextField T="string" Label="Email" Margin="Margin.Dense" Variant="Variant.Outlined"
                              InputType="InputType.Email"
                              @bind-Value="_form.Email" />
                <MudTextField T="string" Label="Teléfono" Margin="Margin.Dense" Variant="Variant.Outlined"
                              @bind-Value="_form.Telefono" />
            </div>

            <MudTextField T="string" Label="Fecha de nacimiento" Margin="Margin.Dense" Variant="Variant.Outlined"
                          InputType="InputType.Date"
                          @bind-Value="_form.FechaNacimiento" />

            @if (_showSede)
            {
                <p class="form-section">Sede de registro</p>
                <MudSelect T="long"
                           Label="Sede *"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           @bind-Value="_sedeSeleccionada">
                    @foreach (var sede in _sedes)
                    {
                        <MudSelectItem Value="@sede.IdSede">@sede.Nombre</MudSelectItem>
                    }
                </MudSelect>
            }

            <p class="form-section">Contacto de emergencia</p>
            <MudTextField T="string" Label="Nombre del contacto" Margin="Margin.Dense" Variant="Variant.Outlined"
                          @bind-Value="_form.ContactoEmergenciaNombre" />
            <MudTextField T="string" Label="Teléfono del contacto" Margin="Margin.Dense" Variant="Variant.Outlined"
                          @bind-Value="_form.ContactoEmergenciaTelefono" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_guardando" OnClick="Cancelar">Cancelar</MudButton>
        <AsyncButton Text="@(Mode == "crear" ? "Crear" : "Guardar")"
                     LoadingText="Guardando..."
                     ButtonType="submit"
                     OnClick="GuardarAsync"
                     IsLoading="_guardando" />
    </DialogActions>
</MudDialog>

@code {
    private sealed class FormData
    {
        public string Nombre { get; set; } = "";
        public string ApellidoPaterno { get; set; } = "";
        public string ApellidoMaterno { get; set; } = "";
        public string Email { get; set; } = "";
        public string Telefono { get; set; } = "";
        public string FechaNacimiento { get; set; } = "";
        public string ContactoEmergenciaNombre { get; set; } = "";
        public string ContactoEmergenciaTelefono { get; set; } = "";
    }

    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private ISociosService Socios { get; set; } = default!;
    [Inject] private ISedesRepository Sedes { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;

    [Parameter] public bool Open { get; set; }
    [Parameter] public string Mode { get; set; } = "crear";
    [Parameter] public Socio? Socio { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private FormData _form = new();
    private bool _showSede;
    private long _sedeSeleccionada;
    private List<Sede> _sedes = [];
    private bool _guardando;
    private bool _inicializado;
    private bool _visible;
    private MudDialog _mudDialog = default!;

    protected override async Task OnInitializedAsync()
    {
        _visible = Open;
        _showSede = Sesion.Current?.IdSede is null;
        if (_showSede)
        {
            try
            {
                _sedes = (await Sedes.GetActivasAsync()).ToList();
            }
            catch
            {
                _sedes = [];
            }
            _sedeSeleccionada = await SedePrincipalPorDefectoAsync();
            if (Mode == "editar" && Socio is not null)
            {
                await AgregarSedeDelSocioSiFaltaAsync();
            }
        }
        InicializarForm();
    }

    private async Task AgregarSedeDelSocioSiFaltaAsync()
    {
        if (_sedes.Any(s => s.IdSede == Socio!.IdSedeRegistro))
        {
            return;
        }
        try
        {
            var sede = await Sedes.GetByIdAsync(Socio!.IdSedeRegistro);
            if (sede is not null)
            {
                _sedes.Add(sede);
            }
        }
        catch
        {
        }
    }

    private async Task<long> SedePrincipalPorDefectoAsync()
    {
        try
        {
            var principal = await Sedes.GetPrincipalAsync();
            if (principal is not null)
            {
                return principal.IdSede;
            }
        }
        catch
        {
        }
        return _sedes.FirstOrDefault()?.IdSede ?? 0;
    }

    protected override void OnParametersSet()
    {
        _visible = Open;
        if (Open && !_inicializado)
        {
            InicializarForm();
        }
        else if (!Open)
        {
            _inicializado = false;
        }
    }

    private void InicializarForm()
    {
        _inicializado = true;
        _form = new FormData();
        if (Mode == "editar" && Socio is not null)
        {
            _form.Nombre = Socio.Nombre;
            _form.ApellidoPaterno = Socio.ApellidoPaterno;
            _form.ApellidoMaterno = Socio.ApellidoMaterno ?? "";
            _form.Email = Socio.Email ?? "";
            _form.Telefono = Socio.Telefono ?? "";
            _form.FechaNacimiento = (Socio.FechaNacimiento ?? "").Length >= 10 ? Socio.FechaNacimiento![..10] : Socio.FechaNacimiento ?? "";
            _form.ContactoEmergenciaNombre = Socio.ContactoEmergenciaNombre ?? "";
            _form.ContactoEmergenciaTelefono = Socio.ContactoEmergenciaTelefono ?? "";
            _sedeSeleccionada = Socio.IdSedeRegistro;
        }
        StateHasChanged();
    }

    private async Task OnVisibleChanged(bool visible)
    {
        _visible = visible;
        if (!visible)
        {
            await OnClose.InvokeAsync();
        }
    }

    private Task Cancelar() => _mudDialog.CloseAsync();

    private async Task GuardarAsync()
    {
        if (_guardando)
        {
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.Nombre))
        {
            Feedback.ShowWarning("El nombre es requerido");
            return;
        }
        if (string.IsNullOrWhiteSpace(_form.ApellidoPaterno))
        {
            Feedback.ShowWarning("El apellido paterno es requerido");
            return;
        }
        if (_showSede && _sedeSeleccionada <= 0)
        {
            Feedback.ShowWarning("Selecciona la sede de registro");
            return;
        }
        if (!string.IsNullOrWhiteSpace(_form.Email) && !_form.Email.Contains('@'))
        {
            Feedback.ShowWarning("El email no es válido");
            return;
        }
        if (!string.IsNullOrWhiteSpace(_form.FechaNacimiento) &&
            !DateTime.TryParse(_form.FechaNacimiento, CultureInfo.InvariantCulture, DateTimeStyles.None, out _))
        {
            Feedback.ShowWarning("La fecha de nacimiento no es válida");
            return;
        }

        _guardando = true;
        try
        {
            var sesion = Sesion.Current!;
            if (Mode == "crear")
            {
                var datos = new CrearSocioDatos
                {
                    Nombre = _form.Nombre.Trim(),
                    ApellidoPaterno = _form.ApellidoPaterno.Trim(),
                    ApellidoMaterno = NuloSiVacio(_form.ApellidoMaterno),
                    Email = NuloSiVacio(_form.Email),
                    Telefono = NuloSiVacio(_form.Telefono),
                    FechaNacimiento = NuloSiVacio(_form.FechaNacimiento),
                    FotoPath = null,
                    ContactoEmergenciaNombre = NuloSiVacio(_form.ContactoEmergenciaNombre),
                    ContactoEmergenciaTelefono = NuloSiVacio(_form.ContactoEmergenciaTelefono),
                };
                await Socios.CrearSocioAsync(sesion.Token, datos, _showSede ? _sedeSeleccionada : null);
                Feedback.ShowSuccess("Miembro creado");
            }
            else
            {
                var datos = new ActualizarSocioDatos
                {
                    IdSocio = Socio!.IdSocio,
                    Nombre = _form.Nombre.Trim(),
                    ApellidoPaterno = _form.ApellidoPaterno.Trim(),
                    ApellidoMaterno = NuloSiVacio(_form.ApellidoMaterno),
                    Email = NuloSiVacio(_form.Email),
                    Telefono = NuloSiVacio(_form.Telefono),
                    FechaNacimiento = NuloSiVacio(_form.FechaNacimiento),
                    FotoPath = Socio.FotoPath,
                    ContactoEmergenciaNombre = NuloSiVacio(_form.ContactoEmergenciaNombre),
                    ContactoEmergenciaTelefono = NuloSiVacio(_form.ContactoEmergenciaTelefono),
                };
                await Socios.ActualizarSocioAsync(sesion.Token, datos);
                Feedback.ShowSuccess("Miembro actualizado");
            }

            await OnSaved.InvokeAsync();
            await _mudDialog.CloseAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError(Mode == "crear" ? "No se pudo crear el miembro" : "No se pudo actualizar el miembro");
        }
        finally
        {
            _guardando = false;
        }
    }

    private static string? NuloSiVacio(string value) =>
        string.IsNullOrWhiteSpace(value) ? null : value.Trim();
}