@page "/miembros"
@* Miembros (MembersListPage.tsx): búsqueda, tabla con estados/huella/último acceso y menú de acciones por fila. *@
@implements IDisposable
@using System.Globalization
@using MudBlazor
@using SmartGym.Core.Common
@using SmartGym.Core.Entities
@using SmartGym.Core.Repositories
@using SmartGym.Core.Services
@using SmartGym.App.Services

<div class="page-head">
    <div>
        <h4>Miembros</h4>
        <p class="page-sub">Registro y gestión de los socios del gimnasio.</p>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AbrirNuevo">Nuevo miembro</MudButton>
</div>

<div class="glass-panel">
    <div class="page-toolbar">
        <MudTextField T="string"
                      Class="search-field"
                      Placeholder="Buscar por nombre, email o teléfono..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Value="@_busqueda"
                      ValueChanged="OnBusquedaChanged" />
        <FiltrosDesplegables Filtros="_definicionesFiltros"
                             VisiblesIniciales="_visiblesIniciales"
                             ConteoAplicados="_filtroEstado.Length > 0 ? 1 : 0"
                             VisiblesChanged="OnVisiblesChangedAsync" />
        @if (_filtrosVisibles.Contains("estado"))
        {
        <MudSelect T="string"
                   OuterClass="filter-field"
                   RelativeWidth="DropdownWidth.Adaptive"
                   Label="Estado"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   Value="@_filtroEstado"
                   ValueChanged="OnFiltroEstadoChanged">
            <MudSelectItem Value="@("")">Todos</MudSelectItem>
            @foreach (var estado in SocioEstados.Validos)
            {
                <MudSelectItem Value="@estado">@EtiquetaEstado(estado)</MudSelectItem>
            }
        </MudSelect>
        }
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th style="text-align: center;">Estado</th>
                    <th style="text-align: center;">Huella</th>
                    <th>Último acceso</th>
                    <th style="text-align: center; width: 56px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_cargando)
                {
                    <tr>
                        <td colspan="7" class="empty-cell">Cargando...</td>
                    </tr>
                }
                else if (_miembros.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty-cell">
                            @(_busqueda.Length > 0 || _filtroEstado.Length > 0 ? "Sin resultados para los filtros aplicados" : "No hay miembros registrados")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var socio in _miembros)
                    {
                        <tr>
                            <td><strong>@NombreCompleto(socio)</strong></td>
                            <td class="muted-cell">@(socio.Telefono ?? "—")</td>
                            <td class="muted-cell">@(socio.Email ?? "—")</td>
                            <td style="text-align: center;">
                                <span class="status-badge @ClaseEstado(socio.Estado)">@EtiquetaEstado(socio.Estado)</span>
                            </td>
                            <td style="text-align: center;">
                                @if (TieneHuella(socio.IdSocio))
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Small" Class="huella-icon" />
                                }
                                else
                                {
                                    <span class="muted">—</span>
                                }
                            </td>
                            <td class="muted-cell">@FormatearFecha(socio.FechaUltimoAcceso)</td>
                            <td style="text-align: center;">
                                <MudMenu AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight"
                                         Class="row-menu">
                                    <ActivatorContent>
                                        @* MudBlazor v9: ActivatorContent recibe MenuContext; el clic ya no
                                           abre el menu implicitamente (breaking change v9), hay que llamar
                                           context.ToggleAsync explicito. Ver
                                           https://github.com/MudBlazor/MudBlazor/issues/12666 *@
                                        <MudIconButton Icon="@Icons.Material.Filled.MoreVert"
                                                       Size="Size.Small"
                                                       Color="Color.Default"
                                                       OnClick="@context.ToggleAsync"
                                                       aria-label="Acciones" />
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick="() => AbrirEditar(socio)">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /> Editar
                                        </MudMenuItem>

                                        @if (socio.Estado == SocioEstados.Activo)
                                        {
                                            <MudMenuItem OnClick="() => PedirCambioEstado(socio, SocioEstados.Inactivo)">
                                                <MudIcon Icon="@Icons.Material.Filled.Pause" Size="Size.Small" /> Desactivar
                                            </MudMenuItem>
                                        }
                                        else if (socio.Estado == SocioEstados.Inactivo)
                                        {
                                            <MudMenuItem OnClick="() => PedirCambioEstado(socio, SocioEstados.Activo)">
                                                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /> Activar
                                            </MudMenuItem>
                                        }

                                        @if (socio.Estado == SocioEstados.Bloqueado)
                                        {
                                            <MudMenuItem OnClick="() => PedirCambioEstado(socio, SocioEstados.Activo)">
                                                <MudIcon Icon="@Icons.Material.Filled.LockOpen" Size="Size.Small" /> Desbloquear
                                            </MudMenuItem>
                                        }
                                        else
                                        {
                                            <MudMenuItem OnClick="() => PedirCambioEstado(socio, SocioEstados.Bloqueado)">
                                                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" /> Bloquear
                                            </MudMenuItem>
                                        }

                                        <MudMenuItem OnClick="() => AbrirEnrolarHuella(socio)">
                                            <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Small" />
                                            @(TieneHuella(socio.IdSocio) ? "Reemplazar huella" : "Registrar huella")
                                        </MudMenuItem>
                                        <MudMenuItem OnClick="() => AbrirAccesoManual(socio)">
                                            <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Small" /> Forzar acceso
                                        </MudMenuItem>
                                        <MudMenuItem OnClick="() => PedirEliminar(socio)">
                                            <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" /> Eliminar
                                        </MudMenuItem>
                                    </ChildContent>
                                </MudMenu>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_miembros.Count > 0)
    {
        <div class="table-footer">
            <span class="muted">Mostrando @_miembros.Count de @_totalRegistros miembro(s)</span>
            <div class="pagination-controls">
                <MudSelect T="int"
                           Label="Ver"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           OuterClass="page-size-field"
                           RelativeWidth="DropdownWidth.Adaptive"
                           Value="_tamanoPagina"
                           ValueChanged="OnTamanoPaginaChanged">
                    @foreach (var tamano in TamanosPagina.Validos)
                    {
                        <MudSelectItem Value="@tamano">@tamano</MudSelectItem>
                    }
                </MudSelect>
                @if (_totalPaginas > 1)
                {
                    <MudPagination Count="_totalPaginas"
                                   Selected="_pagina"
                                   SelectedChanged="OnPaginaChanged"
                                   Color="Color.Primary"
                                   Size="Size.Small" />
                }
            </div>
        </div>
    }
</div>

@if (_formAbierto)
{
    <MiembroFormDialog Open="true"
                       Mode="@FormModo"
                       Socio="_socioEnEdicion"
                       OnClose="CerrarForm"
                       OnSaved="RecargarDespuesDeGuardar" />
}

@if (_accesoAbierto)
{
    <AccesoManualDialog Open="true"
                        Socio="_socioAcceso"
                        OnClose="CerrarAcceso"
                        OnSaved="RecargarDespuesDeGuardar" />
}

@if (_enrolarAbierto)
{
    <FingerprintEnrollDialog Open="true"
                             Socio="_socioEnrolar"
                             TieneHuella="_socioEnrolar is not null && TieneHuella(_socioEnrolar.IdSocio)"
                             OnClose="CerrarEnrolar"
                             OnSaved="RecargarDespuesDeGuardar" />
}

@* La venta y gestión de membresías vive en /membresias (MembresiasPage). *@

<ConfirmDialog IsOpen="_confirmar is not null"
               Titulo="@_confirmar?.Titulo"
               Mensaje="@(_confirmar?.Mensaje ?? "")"
               TextoConfirmar="@(_confirmar?.TextoConfirmar ?? "Confirmar")"
               IsLoading="_confirmarCargando"
               OnConfirm="EjecutarConfirmar"
               OnCancel="CancelarConfirmar" />

@code {
    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private ISociosService Socios { get; set; } = default!;
    [Inject] private ISociosBiometricosRepository Biometricos { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;

    private List<Socio> _miembros = [];
    private HashSet<string> _sociosConHuella = new(StringComparer.OrdinalIgnoreCase);
    private bool _cargando;
    private string _busqueda = "";
    private string _filtroEstado = "";

    // FiltrosDesplegables: un solo filtro secundario, visible por defecto.
    private readonly List<FiltrosDesplegables.FiltroDefinicion> _definicionesFiltros =
        [new("estado", "Estado")];
    private static readonly string[] _visiblesIniciales = ["estado"];
    private HashSet<string> _filtrosVisibles = ["estado"];
    private CancellationTokenSource? _debounce;

    private int _pagina = 1;
    private int _tamanoPagina = TamanosPagina.Default;
    private int _totalRegistros;
    private int _totalPaginas;

    private bool _formAbierto;
    private string FormModo { get; set; } = "crear";
    private Socio? _socioEnEdicion;

    private bool _accesoAbierto;
    private Socio? _socioAcceso;

    private bool _enrolarAbierto;
    private Socio? _socioEnrolar;


    private sealed record ConfirmarTarea(string Titulo, string Mensaje, string TextoConfirmar, Func<Task> Accion);
    private ConfirmarTarea? _confirmar;
    private bool _confirmarCargando;

    protected override async Task OnInitializedAsync()
    {
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        _cargando = true;
        try
        {
            var query = string.IsNullOrWhiteSpace(_busqueda) ? null : _busqueda.Trim();
            var estado = string.IsNullOrWhiteSpace(_filtroEstado) ? null : _filtroEstado;
            var resultado = await Socios.BuscarAsync(sesion.Token, query, estado, _pagina, _tamanoPagina);
            _miembros = resultado.Items.ToList();
            _totalRegistros = resultado.TotalRegistros;
            _totalPaginas = resultado.TotalPaginas;
            _sociosConHuella = (await Biometricos.GetIdsConHuellaAsync()).ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudieron cargar los miembros");
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task OnBusquedaChanged(string value)
    {
        _busqueda = value;
        _pagina = 1;
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
            await CargarAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnFiltroEstadoChanged(string value)
    {
        _filtroEstado = value ?? "";
        _pagina = 1;
        await CargarAsync();
    }

    /// <summary>Al ocultar el filtro se limpia su valor (nunca queda aplicado invisible).</summary>
    private async Task OnVisiblesChangedAsync(IReadOnlyList<string> visibles)
    {
        _filtrosVisibles = visibles.ToHashSet(StringComparer.Ordinal);
        if (!_filtrosVisibles.Contains("estado"))
        {
            _filtroEstado = "";
            _pagina = 1;
            await CargarAsync();
        }
    }

    private async Task OnTamanoPaginaChanged(int value)
    {
        _tamanoPagina = value;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnPaginaChanged(int value)
    {
        _pagina = value;
        await CargarAsync();
    }

    private void AbrirNuevo()
    {
        FormModo = "crear";
        _socioEnEdicion = null;
        _formAbierto = true;
    }

    private void AbrirEditar(Socio socio)
    {
        FormModo = "editar";
        _socioEnEdicion = socio;
        _formAbierto = true;
    }

    private void CerrarForm()
    {
        _formAbierto = false;
        _socioEnEdicion = null;
    }

    private void AbrirAccesoManual(Socio socio)
    {
        _socioAcceso = socio;
        _accesoAbierto = true;
    }

    private void CerrarAcceso()
    {
        _accesoAbierto = false;
        _socioAcceso = null;
    }

    private void AbrirEnrolarHuella(Socio socio)
    {
        _socioEnrolar = socio;
        _enrolarAbierto = true;
    }

    private void CerrarEnrolar()
    {
        _enrolarAbierto = false;
        _socioEnrolar = null;
    }

    private async Task RecargarDespuesDeGuardar() => await CargarAsync();

    private void PedirCambioEstado(Socio socio, string estadoNuevo)
    {
        var (titulo, mensaje, texto) = estadoNuevo switch
        {
            SocioEstados.Inactivo => ("Desactivar miembro",
                $"Se marcará a {NombreCompleto(socio)} como inactivo. No podrá acceder al gimnasio.",
                "Desactivar"),
            SocioEstados.Bloqueado => ("Bloquear miembro",
                $"Se bloqueará el acceso de {NombreCompleto(socio)}. No podrá acceder al gimnasio.",
                "Bloquear"),
            _ => ("Activar miembro", $"Se reactivará a {NombreCompleto(socio)}.", "Activar"),
        };

        _confirmar = new ConfirmarTarea(titulo, mensaje, texto, () => CambiarEstadoAsync(socio, estadoNuevo));
        StateHasChanged();
    }

    private async Task CambiarEstadoAsync(Socio socio, string estadoNuevo)
    {
        var sesion = Sesion.Current!;
        await Socios.CambiarEstadoAsync(sesion.Token, socio.IdSocio, estadoNuevo);
        var accion = estadoNuevo switch
        {
            SocioEstados.Inactivo => "desactivado",
            SocioEstados.Bloqueado => "bloqueado",
            _ => "reactivado",
        };
        Feedback.ShowSuccess($"Miembro {accion}");
        await CargarAsync();
    }

    private void PedirEliminar(Socio socio)
    {
        _confirmar = new ConfirmarTarea("Eliminar miembro",
            $"Se eliminará permanentemente a {NombreCompleto(socio)}. Esta acción no se puede deshacer.",
            "Eliminar",
            () => EliminarAsync(socio));
        StateHasChanged();
    }

    private async Task EliminarAsync(Socio socio)
    {
        var sesion = Sesion.Current!;
        await Socios.EliminarSocioAsync(sesion.Token, socio.IdSocio);
        Feedback.ShowSuccess("Miembro eliminado");
        await CargarAsync();
    }

    private async Task EjecutarConfirmar()
    {
        if (_confirmar is null)
        {
            return;
        }

        _confirmarCargando = true;
        try
        {
            await _confirmar.Accion();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo completar la acción");
        }
        finally
        {
            _confirmarCargando = false;
            _confirmar = null;
            StateHasChanged();
        }
    }

    private void CancelarConfirmar()
    {
        _confirmar = null;
        StateHasChanged();
    }

    private bool TieneHuella(string idSocio) => _sociosConHuella.Contains(idSocio);

    private static string NombreCompleto(Socio socio) =>
        string.Join(" ", new[] { socio.Nombre, socio.ApellidoPaterno, socio.ApellidoMaterno }
            .Where(x => !string.IsNullOrWhiteSpace(x)));

    private static string ClaseEstado(string estado) => estado switch
    {
        SocioEstados.Activo => "status-success",
        SocioEstados.Inactivo => "status-warning",
        SocioEstados.Bloqueado => "status-danger",
        _ => "status-info",
    };

    private static string EtiquetaEstado(string estado) => estado switch
    {
        SocioEstados.Activo => "Activo",
        SocioEstados.Inactivo => "Inactivo",
        SocioEstados.Bloqueado => "Bloqueado",
        SocioEstados.Suspendido => "Suspendido",
        _ => estado,
    };

    private static string FormatearFecha(string? iso)
    {
        if (string.IsNullOrWhiteSpace(iso))
        {
            return "—";
        }
        if (DateTimeOffset.TryParse(iso, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var dto))
        {
            return dto.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.GetCultureInfo("es-MX"));
        }
        return iso;
    }

    public void Dispose() => _debounce?.Cancel();
}