</style>

@code {
    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private IPosService Pos { get; set; } = default!;
    [Inject] private IProductosService Productos { get; set; } = default!;
    [Inject] private ICajaService Caja { get; set; } = default!;
    [Inject] private IInventarioSucursalRepository Inventario { get; set; } = default!;
    [Inject] private ISociosRepository SociosRepo { get; set; } = default!;
    [Inject] private IUsuariosRepository UsuariosRepo { get; set; } = default!;
    [Inject] private ISedesRepository Sedes { get; set; } = default!;
    [Inject] private ITerminalConfigStore Terminal { get; set; } = default!;
    [Inject] private IAuthorizationService Authz { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;
    [Inject] private IEmpresaConfigService EmpresaConfig { get; set; } = default!;
    [Inject] private IPromocionesService Promos { get; set; } = default!;
    [Inject] private IMembresiasService Membresias { get; set; } = default!;
    [Inject] private IPlanesMembresiaRepository PlanesRepo { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    private DotNetObjectReference<PosPage>? _atajosRef;

    private bool _tienePermiso;
    private bool _cargando = true;
    private bool _showSede;
    private long? _idSedeTerminal;
    private List<Sede> _sedes = [];
    private CajaSesion? _cajaAbierta;

    // Snapshot de stock por producto en la sede actual.
    private Dictionary<long, long> _stockPorProducto = [];

    private string _query = "";
    private CancellationTokenSource? _debounce;
    private List<Producto> _productos = [];
    private int _totalResultados;

    // Carrito: idProducto → línea (orden de inserción preservado).
    private sealed record CarritoLinea(Producto Producto, long Cantidad);
    private Dictionary<long, CarritoLinea> _carrito = new();

    // Promociones vigentes de la sede (descuentos por producto + combos).
    private List<PosPromocionInfo> _combosPos = [];
    private Dictionary<long, PosPromocionInfo> _descuentoPorProducto = [];

    // Carrito de combos: idPromocion → línea (el precio cerrado manda).
    private sealed record CarritoComboLinea(PosPromocionInfo Promo, long Cantidad);
    private Dictionary<string, CarritoComboLinea> _combosCarrito = new();

    /// <summary>El backend solo soporta UN combo_membresia por venta
    /// (VentaInfo expone un único idPlan/share): línea única del carrito.</summary>
    private CarritoComboLinea? ComboMembresiaDelCarrito =>
        _combosCarrito.Values.FirstOrDefault(c => c.Promo.Tipo == PromocionTipos.ComboMembresia);

    // Membresía vendida junto a la venta (una sola por cobro, siempre contado).
    private sealed record MembresiaCarritoLinea(long IdPlan, string NombrePlan, long PrecioCentavos);
    private MembresiaCarritoLinea? _membresiaCarrito;
    private bool _membresiaDialogoAbierto;
    private List<PlanMembresia> _planesActivos = [];
    private PlanMembresia? _planDialogoMembresia;

    private Socio? _socioSeleccionado;
    private string _metodoPago = MetodosPago.Efectivo;
    private bool _cobrando;

    // Snapshot del recibo en pantalla: se congela al confirmar la venta porque
    // el carrito se limpia inmediatamente para la siguiente.
    private sealed record ReciboLinea(
        string Descripcion,
        long Cantidad,
        long PrecioUnitarioCentavos,
        long SubtotalCentavos);

    private sealed record ReciboVenta(
        string Folio,
        string Fecha,
        string MetodoPago,
        string? Socio,

        /// <summary>Quién atendió (usuario logueado en el POS al cobrar).</summary>
        string Atendio,
        IReadOnlyList<ReciboLinea> Items,
        long TotalCentavos,
        long SaldoPendienteCentavos,
        string? VenceTexto,
        long? EfectivoRecibidoCentavos,
        long? CambioCentavos);

    private ReciboVenta? _recibo;
    private bool _reciboAbierto;

    // Interruptor global de venta a crédito (Configuración → Punto de venta).
    private bool _permiteCredito;

    // Periféricos (Configuración → Periféricos): impresión del recibo.
    [Inject] private ITicketPrintService Print { get; set; } = default!;
    private string? _impresoraTickets;
    private int _papelAncho = 42;
    private int _densidad = 2;
    private bool _abrirCajonAlImprimir;
    private bool _imprimirAutoAlCobrar;
    private bool _imprimiendoRecibo;

    // Datos del negocio para el encabezado del ticket: lazy (primera impresión).
    private TicketDatosNegocio? _negocioTicket;
    private byte[]? _logoRasterCache;

    /// <summary>
    /// "Atendió" del recibo: Nombre + ApellidoPaterno (sin materno), resuelto
    /// UNA vez por sesión — sesion.Nombre trae el nombre completo con las tres
    /// partes y no sirve para el ticket.
    /// </summary>
    private string? _atendioCorto;
    private string? _logoDataUrl;

    /// <summary>Null = paga el total completo; menor al total = queda a crédito.</summary>
    private long? _montoPagado;

    // Puentes pesos <-> centavos para los MudNumericField: el usuario captura
    // pesos (decimal) y la lógica del carrito/backend opera en centavos. Sin
    // esto, Format="C2" mostraba "$80.00" mientras el valor interno era 80
    // CENTAVOS — el botón de confirmar nunca se habilitaba.
    private decimal? MontoPagadoPesos
    {
        get => _montoPagado / 100m;
        set => _montoPagado = value is null ? null : (long)Math.Round(value.Value * 100m);
    }

    private decimal? EfectivoRecibidoPesos
    {
        get => _efectivoRecibido / 100m;
        set => _efectivoRecibido = value is null ? null : (long)Math.Round(value.Value * 100m);
    }

    // Vaciar carrito: confirmación cuando hay más de una línea.
    private bool _vaciarConfirmacion;
    private string _vaciarMensaje = "";
    // Confirmación de cobro: total congelado al abrir la ventana y efectivo
    // recibido OBLIGATORIO en efectivo (confirmar deshabilitado hasta >= total).
    private bool _confirmacionAbierta;
    private long _totalConfirmacion;
    private long? _efectivoRecibido;

    /// <summary>Plazo del crédito en días; default 10, editable antes de cobrar.</summary>
    private int _plazoCreditoDias = 10;

    // Foco en "Nueva venta" al abrir el recibo: Enter la activa nativamente.
    private bool _enfocarReciboAlAbrir;

    protected override async Task OnInitializedAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        try
        {
            await Authz.RequierePermisoAsync(sesion.Token, PermisoCatalogo.PosVender);
            _tienePermiso = true;
        }
        catch (BusinessException)
        {
            Feedback.ShowError("No tienes permiso para vender en el punto de venta");
            return;
        }

        _showSede = sesion.IdSede is null;
        if (_showSede)
        {
            // Sede de la TERMINAL (mismo mecanismo del Kiosco): se elige una
            // sola vez y persiste; sin ella no se carga nada de venta.
            _idSedeTerminal = await Terminal.ObtenerIdSedeAsync();
            if (_idSedeTerminal is null)
            {
                try
                {
                    _sedes = (await Sedes.GetActivasAsync()).ToList();
                }
                catch
                {
                    _sedes = [];
                }
                StateHasChanged();
                return;
            }
        }

        try
        {
            _permiteCredito = await EmpresaConfig.ObtenerPosPermiteCreditoAsync(sesion.Token);
        }
        catch (BusinessException)
        {
            // Sin sesión válida: el interruptor queda apagado (comportamiento por defecto).
        }

        try
        {
            var perifericos = await EmpresaConfig.ObtenerPerifericosAsync(sesion.Token);
            _impresoraTickets = perifericos.ImpresoraTickets;
            _papelAncho = perifericos.PapelAncho;
            _densidad = perifericos.Densidad;
            _abrirCajonAlImprimir = perifericos.AbrirCajon;
            _imprimirAutoAlCobrar = perifericos.ImprimirAutoAlCobrar;
        }
        catch (BusinessException)
        {
            // Sin configuración: impresión manual y sin impresora (defaults).
        }

        await CargarAsync();
    }

    public void Dispose()
    {
        _debounce?.Cancel();
        _atajosRef?.Dispose();
        // Libera los listeners globales de atajos y escáner (try/catch: el
        // JSRuntime puede no estar disponible al desmontar, misma regla que
        // localStorage).
        try
        {
            _ = JS.InvokeVoidAsync("sgUi.posAtajos", null);
            _ = JS.InvokeVoidAsync("sgUi.scanner", null);
        }
        catch
        {
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Recibo recién abierto: foco en la acción primaria para que Enter
        // (activación nativa del botón) la dispare sin mouse.
        if (_reciboAbierto && _enfocarReciboAlAbrir)
        {
            _enfocarReciboAlAbrir = false;
            try
            {
                await JS.InvokeVoidAsync("sgUi.focus", "#pos-btn-nueva-venta");
            }
            catch (JSException)
            {
            }
        }

        // Registro del listener global de atajos (una sola vez, con permiso).
        if (!firstRender || !_tienePermiso || _atajosRef is not null)
        {
            return;
        }

        try
        {
            _atajosRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("sgUi.posAtajos", _atajosRef);
            await JS.InvokeVoidAsync("sgUi.scanner", _atajosRef);
        }
        catch (JSDisconnectedException)
        {
        }
        catch (JSException)
        {
        }
    }

    /// <summary>Atajos de mostrador desde el listener global: Enter cobra,
    /// +/- ajustan la cantidad del último producto agregado.</summary>
    [JSInvokable]
    public void OnAtajoPos(string key)
    {
        if (!_tienePermiso || _cobrando)
        {
            return;
        }

        switch (key)
        {
            case "Enter":
                // Recibo abierto y el foco no está en el botón (llegó al body):
                // Enter cierra el recibo igualmente.
                if (_reciboAbierto)
                {
                    _reciboAbierto = false;
                    break;
                }
                if (_confirmacionAbierta)
                {
                    // Enter dentro de la ventana: confirma si es válido
                    // (el guard de ConfirmarCobroAsync hace el resto).
                    if (PuedeConfirmarCobro())
                    {
                        _ = ConfirmarCobroAsync();
                    }
                    break;
                }
                if (!CarritoVacio() && _cajaAbierta is not null)
                {
                    AbrirConfirmacionCobro();
                }
                break;
            case "+" or "=":
                AjustarUltimaLinea(+1);
                break;
            case "-" or "_":
                AjustarUltimaLinea(-1);
                break;
        }

        StateHasChanged();
    }

    /// <summary>Código capturado por el lector físico (sgUi.scanner en
    /// index.html): búsqueda exacta por código de barras y agregar al carrito.
    /// Nunca silencio: código inexistente o caja cerrada avisan con toast.
    /// Con el recibo o la confirmación de cobro abiertos se ignora el escaneo
    /// (agregar detrás de un diálogo modal sería confuso).</summary>
    [JSInvokable]
    public async Task OnCodigoEscaneado(string codigo)
    {
        if (!_tienePermiso || _cobrando || _reciboAbierto || _confirmacionAbierta)
        {
            return;
        }

        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        if (_cajaAbierta is null)
        {
            Feedback.ShowWarning("Abre la caja para vender (escaneo ignorado)");
            StateHasChanged();
            return;
        }

        try
        {
            var producto = await Productos.BuscarPorCodigoBarrasAsync(sesion.Token, codigo);
            if (producto is null)
            {
                Feedback.ShowWarning($"Código \"{codigo}\" no encontrado en el catálogo");
                StateHasChanged();
                return;
            }

            await AgregarAlCarritoAsync(producto);
            StateHasChanged();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
            StateHasChanged();
        }
        catch
        {
            Feedback.ShowError("No se pudo buscar el código escaneado");
            StateHasChanged();
        }
    }

    private void AjustarUltimaLinea(long delta)
    {
        var ultima = _carrito.Values.LastOrDefault();
        if (ultima is not null)
        {
            CambiarCantidad(ultima, delta);
        }
    }

    private long IdSedeEfectivo(SessionInfo sesion) =>
        _showSede ? _idSedeTerminal!.Value : sesion.IdSede!.Value;

    /// <summary>Selección única de sede para la terminal (patrón Kiosco): se
    /// persiste en la terminal y a partir de aquí el POS carga normal.</summary>
    private async Task SeleccionarSedeTerminalAsync(Sede sede)
    {
        await Terminal.GuardarIdSedeAsync(sede.IdSede);
        _idSedeTerminal = sede.IdSede;

        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        try
        {
            _permiteCredito = await EmpresaConfig.ObtenerPosPermiteCreditoAsync(sesion.Token);
        }
        catch (BusinessException)
        {
            // Sin configuración: crédito apagado (default).
        }

        await CargarAsync();
    }

    /// <summary>Búsqueda con debounce de 300ms (mismo comportamiento que Miembros/Productos).</summary>
    private async Task OnBusquedaChanged(string value)
    {
        _query = value;
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
            await CargarProductosAsync();
            StateHasChanged();
        }
        catch (TaskCanceledException)
        {
        }
    }

    /// <summary>
    /// Enter en el buscador: agrega al carrito el PRIMER resultado enlistado
    /// (mismo orden real de despliegue — productos filtrados, luego combos) y
    /// limpia el campo, flujo continuo tipo escáner. Sin resultados no hace
    /// nada. Implementa lo anunciado en bed0a80 pero nunca materializado.
    /// </summary>
    private void HandleBusquedaKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || _cobrando || _confirmacionAbierta || _reciboAbierto)
        {
            return;
        }

        var producto = _productos.FirstOrDefault();
        if (producto is not null)
        {
            // Detail=0: sin blur interop (el campo se limpiará abajo).
            _ = AgregarAlCarritoAsync(producto, new MouseEventArgs());
            _ = OnBusquedaChanged("");
            return;
        }

        var combo = CombosFiltrados().FirstOrDefault();
        if (combo is not null)
        {
            AgregarComboAlCarrito(combo);
            _ = OnBusquedaChanged("");
        }
    }

    /// <summary>Abre el mini-form de membresía (requiere caja abierta).</summary>
    private async Task AbrirDialogoMembresia()
    {
        if (_cajaAbierta is null)
        {
            Feedback.ShowWarning("Abre la caja antes de vender membresías");
            return;
        }

        try
        {
            _planesActivos = (await PlanesRepo.GetActivosAsync()).ToList();
        }
        catch
        {
            _planesActivos = [];
        }

        _planDialogoMembresia = null;
        _membresiaDialogoAbierto = true;
        StateHasChanged();
    }

    private void OnPlanDialogoChanged(PlanMembresia? plan)
    {
        _planDialogoMembresia = plan;
    }

    /// <summary>Búsqueda en vivo sobre planes activos — mismo patrón que productos.</summary>
    private async Task<IEnumerable<PlanMembresia?>> BuscarPlanesDialogoAsync(string arg, CancellationToken ct)
    {
        try
        {
            var planes = await PlanesRepo.GetActivosAsync(ct);
            var texto = arg?.Trim() ?? "";
            return planes
                .Where(p => texto.Length == 0 || p.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
                .Cast<PlanMembresia?>();
        }
        catch
        {
            return [];
        }
    }

    /// <summary>Una sola membresía por cobro — agregar otra reemplaza la pendiente con aviso.</summary>
    private void AgregarMembresiaAlCarrito()
    {
        if (_planDialogoMembresia is null)
        {
            return;
        }

        if (_membresiaCarrito is not null)
        {
            Feedback.ShowWarning("Ya había una membresía en el carrito — se reemplazó por la nueva");
        }

        _membresiaCarrito = new MembresiaCarritoLinea(
            _planDialogoMembresia.IdPlan,
            _planDialogoMembresia.Nombre,
            _planDialogoMembresia.PrecioCentavos);
        _membresiaDialogoAbierto = false;
        StateHasChanged();
    }

    private void QuitarMembresiaDelCarrito() => _membresiaCarrito = null;

    private void CerrarDialogoMembresia() => _membresiaDialogoAbierto = false;

    /// <summary>Carga caja abierta + catálogo + stock snapshot de la sede.</summary>
    private async Task CargarAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        _cargando = true;
        try
        {
            _cajaAbierta = await Caja.ObtenerCajaAbiertaAsync(sesion.Token, _showSede ? _idSedeTerminal : null);
            await CargarProductosAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo cargar el punto de venta");
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private async Task CargarProductosAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        var query = string.IsNullOrWhiteSpace(_query) ? null : _query.Trim();
        var resultado = await Productos.BuscarAsync(sesion.Token, query, pagina: 1, tamanoPagina: TamanosPagina.Cincuenta, esActivo: true);
        _productos = resultado.Items.ToList();
        _totalResultados = resultado.TotalRegistros;

        if (_productos.Count > 0)
        {
            var sedeStock = IdSedeEfectivo(sesion);
            _stockPorProducto = (await Inventario.GetBySedeAsync(sedeStock)).ToDictionary(i => i.IdProducto, i => i.Stock);
        }
        else
        {
            _stockPorProducto = [];
        }

        // Promociones vigentes: descuentos indexados por producto y combos para
        // la grilla. Una promoción no vigente simplemente no aparece.
        try
        {
            var promos = await Promos.ObtenerParaPosAsync(sesion.Token);
            _descuentoPorProducto = promos
                .Where(p => p.Tipo == PromocionTipos.Descuento && p.IdProducto is not null)
                .GroupBy(p => p.IdProducto!.Value)
                .ToDictionary(g => g.Key, g => g.First());
            _combosPos = promos.Where(p => p.Tipo == PromocionTipos.Combo || p.Tipo == PromocionTipos.ComboMembresia).ToList();
        }
        catch
        {
            _descuentoPorProducto = [];
            _combosPos = [];
        }
    }

    private long? StockDe(Producto p) =>
        p.RequiereInventario && _stockPorProducto.TryGetValue(p.IdProducto, out var stock) ? stock : null;

    private bool Agotado(Producto p) => p.RequiereInventario && (StockDe(p) ?? 0) <= 0;

    /// <summary>Precio final del producto con su descuento vigente (null si no tiene).</summary>
    private PosPromocionInfo? DescuentoDe(Producto p) =>
        _descuentoPorProducto.TryGetValue(p.IdProducto, out var d) ? d : null;

    /// <summary>
    /// Carrito vacío considerando AMBOS diccionarios: productos y combos.
    /// El botón Cobrar, su guard y el atajo de Enter deben usar esto — mirar
    /// solo _carrito bloqueaba ventas de solo-combos.
    /// </summary>
    private bool CarritoVacio() =>
        _carrito.Count == 0 && _combosCarrito.Count == 0 && _membresiaCarrito is null;

    /// <summary>Combos de la grilla, filtrados por la búsqueda activa (por nombre o componentes).</summary>
    private IEnumerable<PosPromocionInfo> CombosFiltrados()
    {
        if (_query.Trim().Length == 0)
        {
            return _combosPos;
        }
        var q = _query.Trim();
        return _combosPos.Where(c =>
            c.Nombre.Contains(q, StringComparison.OrdinalIgnoreCase) ||
            c.Componentes.Any(x => x.DescripcionProducto.Contains(q, StringComparison.OrdinalIgnoreCase)));
    }

    /// <summary>Combo agotado: algún componente con inventario no alcanza para una unidad más.</summary>
    private bool ComboAgotado(PosPromocionInfo combo)
    {
        var enCarrito = _combosCarrito.TryGetValue(combo.IdPromocion, out var linea) ? linea.Cantidad : 0;
        foreach (var c in combo.Componentes)
        {
            // Solo los componentes presentes en el snapshot requieren inventario.
            if (!_stockPorProducto.TryGetValue(c.IdProducto, out var stock))
            {
                continue;
            }
            if (c.Cantidad * (enCarrito + 1) > stock)
            {
                return true;
            }
        }
        return false;
    }

    private void AgregarComboAlCarrito(PosPromocionInfo promo)
    {
        if (_cajaAbierta is null || ComboAgotado(promo))
        {
            return;
        }

        // combo_membresia exige socio titular (la membresía incluida lo requiere).
        if (promo.Tipo == PromocionTipos.ComboMembresia && _socioSeleccionado is null)
        {
            Feedback.ShowWarning("Selecciona el socio titular antes de agregar un combo con membresía");
            return;
        }

        // Un solo combo_membresia por venta y con cantidad 1: el backend crea
        // una única membresía (VentaInfo expone un solo idPlan/share).
        if (promo.Tipo == PromocionTipos.ComboMembresia && ComboMembresiaDelCarrito is not null)
        {
            Feedback.ShowWarning("Solo se puede vender un combo con membresía por venta");
            return;
        }

        var esComboMembresiaNuevo = promo.Tipo == PromocionTipos.ComboMembresia;
        var cantidadActual = _combosCarrito.TryGetValue(promo.IdPromocion, out var linea) ? linea.Cantidad : 0;
        if (esComboMembresiaNuevo && cantidadActual >= 1)
        {
            Feedback.ShowWarning("Solo se puede vender un combo con membresía por venta");
            return;
        }
        _combosCarrito[promo.IdPromocion] = new CarritoComboLinea(promo, cantidadActual + 1);
    }

    private void CambiarCantidadCombo(CarritoComboLinea linea, long delta)
    {
        var nueva = linea.Cantidad + delta;
        if (nueva <= 0)
        {
            _combosCarrito.Remove(linea.Promo.IdPromocion);
            return;
        }
        // El backend crea UNA sola membresía por venta: no permitir >1 unidad.
        if (linea.Promo.Tipo == PromocionTipos.ComboMembresia && nueva > 1)
        {
            Feedback.ShowWarning("Solo se puede vender un combo con membresía por venta");
            return;
        }
        _combosCarrito[linea.Promo.IdPromocion] = linea with { Cantidad = nueva };
    }

    private async Task<IEnumerable<Socio?>> BuscarSociosAsync(string arg, CancellationToken ct)
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return [];
        }
        var pagina = await SociosRepo.SearchAsync(string.IsNullOrWhiteSpace(arg) ? null : arg.Trim(), pagina: 1, tamanoPagina: 10, ct: ct);
        return pagina.Items.Cast<Socio?>();
    }

    private void OnSocioChangedAsync(Socio? socio) => _socioSeleccionado = socio;

    /// <summary>Al salir del método Crédito se limpia el monto parcial: con
    /// Efectivo/Tarjeta/Transferencia la venta siempre es de pago completo.</summary>
    private void OnMetodoPagoChangedAsync(string metodo)
    {
        _metodoPago = metodo;
        if (metodo != MetodosPago.Credito)
        {
            _montoPagado = null;
        }
    }

    /// <summary>Agrega al carrito y, si el toque fue con puntero (Detail > 0;
    /// la activación por teclado reporta Detail = 0), suelta el foco de la
    /// tarjeta para que Enter después signifique "cobrar", no re-agregar.</summary>
    private async Task AgregarAlCarritoAsync(Producto p, MouseEventArgs e)
    {
        await AgregarAlCarritoAsync(p);

        if (e.Detail > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("sgUi.blurActivo");
            }
            catch
            {
                // Sin blur el atajo de Enter simplemente re-agrega: degradación aceptable.
            }
        }
    }

    /// <summary>Núcleo compartido: valida caja/stock e incrementa cantidad si
    /// el producto ya está en el carrito (re-escanear = +1). Sin lógica de
    /// foco: el escaneo del lector no es un clic de tarjeta.</summary>
    private Task AgregarAlCarritoAsync(Producto p)
    {
        if (_cajaAbierta is null)
        {
            return Task.CompletedTask;
        }

        var cantidadActual = _carrito.TryGetValue(p.IdProducto, out var linea) ? linea.Cantidad : 0;
        if (p.RequiereInventario && cantidadActual >= (StockDe(p) ?? 0))
        {
            return Task.CompletedTask;
        }

        _carrito[p.IdProducto] = new CarritoLinea(p, cantidadActual + 1);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void CambiarCantidad(CarritoLinea linea, long delta)
    {
        var nueva = linea.Cantidad + delta;
        if (nueva <= 0)
        {
            _carrito.Remove(linea.Producto.IdProducto);
            return;
        }

        if (delta > 0 && linea.Producto.RequiereInventario && nueva > (StockDe(linea.Producto) ?? 0))
        {
            return;
        }

        _carrito[linea.Producto.IdProducto] = linea with { Cantidad = nueva };
    }

    private long TotalCarrito() =>
        _carrito.Values.Sum(l =>
            {
                var d = DescuentoDe(l.Producto);
                return (d?.PrecioFinalCentavos ?? l.Producto.PrecioVentaCentavos) * l.Cantidad;
            })
        + _combosCarrito.Values.Sum(c => c.Promo.PrecioComboCentavos * c.Cantidad)
        + (_membresiaCarrito?.PrecioCentavos ?? 0);

    /// <summary>
    /// Suma a precios de LISTA: productos sin aplicar su promo + combos
    /// valorados por su precio de lista total (fallback: suma de componentes).
    /// La diferencia con TotalCarrito() es el ahorro de promociones — se
    /// muestra tachado junto al total cuando > 0.
    /// </summary>
    private long TotalOriginal() =>
        _carrito.Values.Sum(l => l.Producto.PrecioVentaCentavos * l.Cantidad)
        + _combosCarrito.Values.Sum(c => (c.Promo.PrecioListaTotalCentavos > 0 ? c.Promo.PrecioListaTotalCentavos : c.Promo.SubtotalComponentesCentavos) * c.Cantidad)
        + (_membresiaCarrito?.PrecioCentavos ?? 0);

    /// <summary>
    /// Paso 1 del cobro: valida y abre la ventana de confirmación con el total
    /// congelado. Nada se procesa hasta ConfirmarCobroAsync.
    /// </summary>
    private void AbrirConfirmacionCobro()
    {
        if (Sesion.Current is null || _cobrando)
        {
            return;
        }

        if (CarritoVacio())
        {
            Feedback.ShowWarning("El carrito está vacío");
            return;
        }
        if (_cajaAbierta is null)
        {
            Feedback.ShowError("No hay caja abierta — abre caja antes de vender");
            return;
        }

        // Membresía en carrito: exige socio titular y bloquea el método Crédito
        // (siempre de contado — sin pago parcial ni cuenta por cobrar).
        if (_membresiaCarrito is not null && _socioSeleccionado is null)
        {
            Feedback.ShowWarning("La membresía requiere un socio titular — selecciónalo arriba");
            return;
        }
        if (_membresiaCarrito is not null && _metodoPago == MetodosPago.Credito)
        {
            Feedback.ShowWarning("La membresía se vende solo de contado — elige otro método de pago");
            return;
        }

        // Avisar antes, no esperar el error del servidor (mismo criterio que
        // Membresías/Caja): pago incompleto solo vía método Crédito con
        // pos.permite_credito encendido y monto válido.
        _totalConfirmacion = TotalCarrito();
        var esCredito = _metodoPago == MetodosPago.Credito;
        if (_montoPagado is not null)
        {
            if (esCredito && !_permiteCredito)
            {
                Feedback.ShowWarning("La venta a crédito no está habilitada — habilita el crédito en Configuración");
                return;
            }
            if (_montoPagado.Value < 0 || _montoPagado.Value > _totalConfirmacion)
            {
                Feedback.ShowWarning("El monto pagado debe estar entre cero y el total de la venta");
                return;
            }
        }
        else if (esCredito)
        {
            // Método Crédito sin monto = queda debiendo todo: requiere socio y
            // crédito habilitado; el plazo viaja igual.
            if (!_permiteCredito)
            {
                Feedback.ShowWarning("La venta a crédito no está habilitada — habilita el crédito en Configuración");
                return;
            }
            if (_socioSeleccionado is null)
            {
                Feedback.ShowWarning("Selecciona el socio para registrar la venta a crédito");
                return;
            }
        }

        // Efectivo: el recibido es obligatorio y arranca vacío cada venta.
        _efectivoRecibido = null;
        _confirmacionAbierta = true;
        StateHasChanged();
    }

    private bool EsMetodoEfectivo =>
        string.Equals(_metodoPago, MetodosPago.Efectivo, StringComparison.OrdinalIgnoreCase);

    /// <summary>Confirmar habilitado solo con recibido >= total cuando es efectivo.</summary>
    private bool PuedeConfirmarCobro() =>
        !EsMetodoEfectivo || (_efectivoRecibido is not null && _efectivoRecibido.Value >= _totalConfirmacion);

    private long CambioCalculado() =>
        Math.Max(0, (_efectivoRecibido ?? 0) - _totalConfirmacion);

    private void HandleConfirmacionKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && PuedeConfirmarCobro())
        {
            _ = ConfirmarCobroAsync();
        }
    }

    /// <summary>Paso 2 del cobro: registra la venta y muestra el recibo.
    /// Si solo hay membresía en el carrito, salta RegistrarVentaAsync y
    /// llama directo a VenderAsync — el backend rechaza items vacíos.</summary>
    private async Task ConfirmarCobroAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null || _cobrando)
        {
            return;
        }

        if (!PuedeConfirmarCobro())
        {
            Feedback.ShowWarning("El efectivo recibido debe cubrir al menos el total");
            return;
        }

        var esCredito = _metodoPago == MetodosPago.Credito;
        var esEfectivo = EsMetodoEfectivo;

        // Guard: membresía (suelta o dentro de combo_membresia) requiere socio.
        if ((_membresiaCarrito is not null || ComboMembresiaDelCarrito is not null)
            && _socioSeleccionado is null)
        {
            Feedback.ShowWarning("La membresía requiere un socio titular");
            return;
        }

        _confirmacionAbierta = false;
        _cobrando = true;
        try
        {
            // ------------------------------------------------------------------
            // CASO 1: SOLO membresía (sin productos ni combos) → VenderAsync directo.
            // El backend rechaza items vacíos, así que no se llama RegistrarVentaAsync.
            // ------------------------------------------------------------------
            if (_membresiaCarrito is not null && _carrito.Count == 0 && _combosCarrito.Count == 0)
            {
                await VenderMembresiaSoloAsync(sesion);
                return;
            }

            // ------------------------------------------------------------------
            // CASO 2: venta normal de productos/combos (+ membresía si hay).
            // ------------------------------------------------------------------
            await ConfirmarCobroConProductosAsync(sesion);
        }
        finally
        {
            _cobrando = false;
        }
    }

    /// <summary>Caso 1: carrito con SOLO membresía suelta — sin productos ni combos.
    /// Llama directo a Membresias.VenderAsync (contado completo). No genera venta,
    /// no muestra recibo — Feedback.Success + limpiar.</summary>
    private async Task VenderMembresiaSoloAsync(SessionInfo sesion)
    {
        var socio = _socioSeleccionado!;
        var plan = _membresiaCarrito!;

        try
        {
            await Membresias.VenderAsync(
                sesion.Token,
                socio.IdSocio,
                plan.IdPlan,
                _metodoPago,
                plan.PrecioCentavos,
                _showSede ? _idSedeTerminal : null);

            Feedback.ShowSuccess($"Membresía {plan.NombrePlan} vendida a {socio.Nombre}");
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo vender la membresía");
        }

        _membresiaCarrito = null;
        _socioSeleccionado = null;
        _montoPagado = null;
        _efectivoRecibido = null;
        StateHasChanged();
    }
    /// <summary>
    /// Caso 2: venta normal de productos/combos (+ membresía si hay).
    /// Registra la venta vía RegistrarVentaAsync y luego VenderAsync para la
    /// membresía. Muestra recibo y limpia el carrito.
    /// </summary>
    private async Task ConfirmarCobroConProductosAsync(SessionInfo sesion)
    {
        var esCredito = _metodoPago == MetodosPago.Credito;
        var esEfectivo = EsMetodoEfectivo;
        var _cobrando = false;
        try
        {
            var items = new List<VentaItem>();
            foreach (var l in _carrito.Values)
            {
                items.Add(new VentaItem { IdProducto = l.Producto.IdProducto, Cantidad = l.Cantidad });
            }
            foreach (var c in _combosCarrito.Values)
            {
                items.Add(new VentaItem { IdPromocion = c.Promo.IdPromocion, Cantidad = c.Cantidad });
            }

            var input = new RegistrarVentaInput
            {
                Items = items,
                IdSocio = _socioSeleccionado?.IdSocio,
                MetodoPago = _metodoPago,
                // En crédito, campo vacío = no pagó nada (queda debiendo todo);
                // si cubre el total, el backend ni genera cuenta.
                MontoPagadoCentavos = esCredito ? (_montoPagado ?? 0) : _montoPagado,
                PlazoCreditoDias = _plazoCreditoDias,
            };

            var venta = await Pos.RegistrarVentaAsync(
                sesion.Token, input, _showSede ? _idSedeTerminal : null);

            // Membresía del carrito: segunda llamada de servicio DESPUÉS de la
            // venta de productos (dos transacciones — tradeoff documentado).
            // Si falla, los productos ya están vendidos y se informa con
            // éxito-parcial; la membresía puede reintentarse desde /membresías.
            string? errorMembresia = null;
            if (_membresiaCarrito is not null && _socioSeleccionado is not null)
            {
                try
                {
                    await Membresias.VenderAsync(
                        sesion.Token,
                        _socioSeleccionado.IdSocio,
                        _membresiaCarrito.IdPlan,
                        _metodoPago,
                        _membresiaCarrito.PrecioCentavos,
                        _showSede ? _idSedeTerminal : null);
                }
                catch (BusinessException ex)
                {
                    errorMembresia = ex.Message;
                }
                catch
                {
                    errorMembresia = "No se pudo registrar la membresía";
                }
            }

            // Membresía incluida en un combo_membresia: el backend la separó del
            // precio cerrado en VentaInfo (IdPlanComboMembresia/PlanShare) — el
            // dinero ya entró con la venta, así que la segunda llamada NO genera
            // otro movimiento de caja ni cuenta por cobrar.
            ReciboLinea? lineaMembresiaCombo = null;
            string? errorMembresiaCombo = null;
            var comboMembresia = ComboMembresiaDelCarrito;
            if (comboMembresia is not null && venta.IdPlanComboMembresia is not null && _socioSeleccionado is not null)
            {
                try
                {
                    await Membresias.VenderAsync(
                        sesion.Token,
                        _socioSeleccionado.IdSocio,
                        venta.IdPlanComboMembresia.Value,
                        _metodoPago,
                        venta.PlanShareCentavos,
                        _showSede ? _idSedeTerminal : null,
                        idVentaPosOrigen: venta.IdVenta);

                    lineaMembresiaCombo = new ReciboLinea(
                        $"Membresía {comboMembresia.Promo.NombrePlan}",
                        1,
                        venta.PlanShareCentavos,
                        venta.PlanShareCentavos);
                }
                catch (BusinessException ex)
                {
                    errorMembresiaCombo = ex.Message;
                }
                catch
                {
                    errorMembresiaCombo = "No se pudo registrar la membresía";
                }
            }

            // Recibo en pantalla (reemplaza al snackbar de "Venta registrada"):
            // snapshot ANTES de limpiar, porque el carrito ya no estará.
            _recibo = new ReciboVenta(
                Folio: venta.IdVenta,
                Fecha: DateTime.Now.ToString("dd/MM/yyyy HH:mm", CultureInfo.GetCultureInfo("es-MX")),
                MetodoPago: Capitalizar(_metodoPago),
                Socio: _socioSeleccionado is null
                    ? null
                    : $"{_socioSeleccionado.Nombre} {_socioSeleccionado.ApellidoPaterno}".Trim(),
                Atendio: await ResolverAtendioCortoAsync(sesion),
                Items: _carrito.Values.Select(l =>
                    {
                        var d = DescuentoDe(l.Producto);
                        var precioFinal = d?.PrecioFinalCentavos ?? l.Producto.PrecioVentaCentavos;
                        return new ReciboLinea(
                            l.Producto.Descripcion,
                            l.Cantidad,
                            precioFinal,
                            precioFinal * l.Cantidad);
                    })
                    .Concat(_combosCarrito.Values.Select(c => new ReciboLinea(
                        $"Combo {c.Promo.Nombre}",
                        c.Cantidad,
                        c.Promo.PrecioComboCentavos,
                        c.Promo.PrecioComboCentavos * c.Cantidad)))
                    .Concat(errorMembresia is null && _membresiaCarrito is not null
                        ? [new ReciboLinea(
                            $"Membresía {_membresiaCarrito.NombrePlan}",
                            1,
                            _membresiaCarrito.PrecioCentavos,
                            _membresiaCarrito.PrecioCentavos)]
                        : Array.Empty<ReciboLinea>())
                    .Concat(lineaMembresiaCombo is not null
                        ? [lineaMembresiaCombo]
                        : Array.Empty<ReciboLinea>())
                    .ToList(),
                TotalCentavos: venta.TotalCentavos,
                SaldoPendienteCentavos: venta.SaldoPendienteCentavos,

                // Vencimiento REAL de la cuenta creada (plazo usado en la venta).
                VenceTexto: TicketVentaMapper.FormatearFechaIso(venta.SaldoVenceIsoUtc),

                // Efectivo/cambio capturados en la confirmación (solo efectivo).
                EfectivoRecibidoCentavos: esEfectivo ? _efectivoRecibido : null,
                CambioCentavos: esEfectivo ? CambioCalculado() : null);

            // El backend ya descontó stock y generó el movimiento de caja:
            // refresca snapshot y limpia el carrito para la siguiente venta.
            _carrito = new Dictionary<long, CarritoLinea>();
            _combosCarrito = new Dictionary<string, CarritoComboLinea>();
            _membresiaCarrito = null;
            _socioSeleccionado = null;
            _montoPagado = null;
            _efectivoRecibido = null;
            await CargarProductosAsync();

            // Contexto empresa/sede/logo del preview (lazy: solo la primera
            // venta de la sesión paga la lectura; después viene de caché).
            try
            {
                await CargarNegocioTicketAsync();
                StateHasChanged();
            }
            catch
            {
                // Preview con defaults; Reimprimir reportará su propio error si aplica.
            }

            _reciboAbierto = true;
            _enfocarReciboAlAbrir = true;
            StateHasChanged();

            if (errorMembresia is not null)
            {
                // Éxito-parcial: los productos ya están vendidos; la membresía
                // puede reintentarse desde /pos o /membresías.
                Feedback.ShowError($"Productos vendidos, pero la membresía falló: {errorMembresia}");
            }

            if (errorMembresiaCombo is not null)
            {
                // Éxito-parcial: la venta (y su cobro) ya quedó registrada; la
                // membresía del combo puede reintentarse desde /membresías.
                Feedback.ShowError(
                    $"Productos vendidos, pero la membresía del combo falló: {errorMembresiaCombo}");
            }

            if (_imprimirAutoAlCobrar)
            {
                // Complemento del recibo visual: si la impresión falla,
                // ImprimirReciboAsync lo reporta — la venta ya está registrada.
                _ = ImprimirReciboAsync();
            }
        }
        catch (BusinessException ex)
        {
            // Incluye stock_insuficiente por desincronización del snapshot.
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo registrar la venta");
        }
        finally
        {
            _cobrando = false;
        }
    }

    /// <summary>Elimina una línea completa del carrito de productos.</summary>
    private void EliminarLinea(CarritoLinea linea) =>
        _carrito.Remove(linea.Producto.IdProducto);

    /// <summary>Elimina una línea completa de combo.</summary>
    private void EliminarLineaCombo(CarritoComboLinea linea) =>
        _combosCarrito.Remove(linea.Promo.IdPromocion);

    /// <summary>
    /// Vaciar carrito: con más de una línea pide confirmación (evita vaciados
    /// accidentales); con una sola, vacía directo.
    /// </summary>
    private void PedirVaciarCarrito()
    {
        var lineas = _carrito.Count + _combosCarrito.Count;
        if (lineas == 0)
        {
            return;
        }

        if (lineas > 1)
        {
            _vaciarConfirmacion = true;
            StateHasChanged();
            return;
        }

        VaciarCarritoAhora();
    }

    private void VaciarCarritoConfirmadoAsync()
    {
        VaciarCarritoAhora();
        _vaciarConfirmacion = false;
        StateHasChanged();
    }

    private void VaciarCarritoAhora()
    {
        _carrito = new Dictionary<long, CarritoLinea>();
        _combosCarrito = new Dictionary<string, CarritoComboLinea>();
        _montoPagado = null;
        _efectivoRecibido = null;
        Feedback.ShowSuccess("Carrito vaciado");
    }
    private static string Capitalizar(string texto) =>
        string.IsNullOrEmpty(texto) ? texto : char.ToUpperInvariant(texto[0]) + texto[1..];

    /// <summary>Mismo criterio que el ticket impreso: prefijo corto del folio.</summary>
    private static string FolioCorto(string folio) =>
        folio.Length <= 8 ? folio : folio[..8];

    /// <summary>Nombre corto (sin apellido materno) para el recibo; cacheado por sesión.</summary>
    private async Task<string> ResolverAtendioCortoAsync(SessionInfo sesion)
    {
        if (_atendioCorto is not null)
        {
            return _atendioCorto;
        }

        try
        {
            var usuario = await UsuariosRepo.GetByIdAsync(sesion.IdUsuario);
            _atendioCorto = usuario is null
                ? "POS"
                : string.Join(" ", new[] { usuario.Nombre, usuario.ApellidoPaterno }
                    .Where(p => !string.IsNullOrWhiteSpace(p)));
        }
        catch
        {
            _atendioCorto = "POS";
        }
        return string.IsNullOrWhiteSpace(_atendioCorto) ? "POS" : _atendioCorto;
    }

    private static string FormatearMonto(long centavos) =>
        (centavos / 100m).ToString("C2", CultureInfo.GetCultureInfo("es-MX"));

    /// <summary>
    /// Imprime el ticket del recibo (botón o impresión automática). Un fallo de
    /// impresora NO afecta la venta: ya está registrada; solo se reporta.
    /// </summary>
    private async Task ImprimirReciboAsync()
    {
        if (_recibo is null || _imprimiendoRecibo)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_impresoraTickets))
        {
            Feedback.ShowWarning("Sin impresora de tickets — configúrala en Configuración → Periféricos");
            return;
        }

        _imprimiendoRecibo = true;
        StateHasChanged();
        try
        {
            var bytes = await ConstruirEscposDeRecibo();
            await Print.ImprimirRawAsync(_impresoraTickets.Trim(), bytes);
            Feedback.ShowSuccess($"Ticket enviado a {_impresoraTickets}");
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo imprimir el ticket");
        }
        finally
        {
            _imprimiendoRecibo = false;
            StateHasChanged();
        }
    }

    private async Task<byte[]> ConstruirEscposDeRecibo()
    {
        var recibo = _recibo!;
        await CargarNegocioTicketAsync();

            var payload = TicketVentaMapper.DesdeVenta(
                folio: recibo.Folio,
                fechaTexto: recibo.Fecha,
                metodoPago: recibo.MetodoPago,
                estado: "completada",
                socio: recibo.Socio,
                items: recibo.Items.Select(l => new TicketItemInput(
                    l.Descripcion, l.Cantidad, l.PrecioUnitarioCentavos, l.SubtotalCentavos)).ToList(),
                totalCentavos: recibo.TotalCentavos,
                saldoPendienteCentavos: recibo.SaldoPendienteCentavos,
                venceTexto: recibo.VenceTexto,
                negocio: _negocioTicket!,
                logoRaster: _logoRasterCache,
                papelAncho: _papelAncho,
                densidad: _densidad,
                abrirCajon: _abrirCajonAlImprimir,
                efectivoRecibidoCentavos: recibo.EfectivoRecibidoCentavos,
                cambioCentavos: recibo.CambioCentavos);

        return TicketEscposBuilder.Build(payload);
    }

    /// <summary>Datos de empresa/sede y logo para el ticket: una sola carga por sesión del POS.</summary>
    private async Task CargarNegocioTicketAsync()
    {
        if (_negocioTicket is not null)
        {
            return;
        }

        var sesion = Sesion.Current;
        if (sesion is null)
        {
            throw BusinessException.Validation("Sesión no válida", "sesion_invalida");
        }

        try
        {
            var (empresa, sede, logoDataUrl) = await EmpresaConfig.ObtenerAsync(sesion.Token);
            _negocioTicket = new TicketDatosNegocio(
                empresa.NombreComercial,
                empresa.Rfc,
                sede.Nombre,
                sede.Direccion,
                sede.Telefono,
                Cajero: "POS",
                MensajePie: "¡Gracias por su compra!");
            _logoDataUrl = logoDataUrl;
            _logoRasterCache = await Print.RasterizarLogoAsync(
                TicketVentaMapper.DecodificarDataUrl(logoDataUrl) ?? [], _papelAncho, 384);
        }
        catch (BusinessException)
        {
            // Sin configuración de empresa: ticket con defaults del builder.
            _negocioTicket = new TicketDatosNegocio(null, null, "Smart Gym", null, null, "POS", null);
        }
    }

    /// <summary>Snapshot del recibo → items del preview/ticket.</summary>
    private IReadOnlyList<SmartGym.Core.Printing.TicketItemInput> ReciboComoItems() =>
        _recibo!.Items.Select(l => new SmartGym.Core.Printing.TicketItemInput(
            l.Descripcion, l.Cantidad, l.PrecioUnitarioCentavos, l.SubtotalCentavos)).ToList();
}
