@page "/productos"
@* ProductosPage: catálogo del punto de venta. Alta/edición/desactivación de
   productos y ajuste manual de stock por sede. La venta vive en /pos; el
   historial de lo vendido en /ventas — aquí solo se administra el catálogo.
   Categorías diferidas: IdCategoria es nullable y no bloquea nada.
   Estructura replicada de MiembrosPage (referencia de listados): toolbar con
   búsqueda con debounce, filtro estado, tabla data-table, menú de tres puntos
   por fila y paginación. *@
@implements IDisposable
@using System.Globalization
@using MudBlazor
@using SmartGym.Core.Common
@using SmartGym.Core.Entities
@using SmartGym.Core.Repositories
@using SmartGym.Core.Services
@using SmartGym.App.Services

<div class="page-head">
    <div>
        <h4>Productos</h4>
        <p class="page-sub">Catálogo del punto de venta y stock por sede.</p>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AbrirAlta">Nuevo producto</MudButton>
</div>

<div class="glass-panel">
    <div class="page-toolbar">
        @if (_showSede && _sedes.Count > 1)
        {
            <MudSelect T="long"
                       Label="Sede (stock)"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       OuterClass="filter-field"
                       RelativeWidth="DropdownWidth.Adaptive"
                       Value="_sedeSeleccionada"
                       ValueChanged="OnSedeChangedAsync">
                @foreach (var sede in _sedes)
                {
                    <MudSelectItem Value="@sede.IdSede">@sede.Nombre</MudSelectItem>
                }
            </MudSelect>
        }
        <MudTextField T="string"
                      Class="search-field"
                      Placeholder="Buscar por nombre o código de barras..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Value="@_query"
                      ValueChanged="OnBusquedaChanged" />
        <FiltrosDesplegables Filtros="_definicionesFiltros"
                             VisiblesIniciales="_visiblesIniciales"
                             ConteoAplicados="_filtroEstado.Length > 0 ? 1 : 0"
                             VisiblesChanged="OnVisiblesChangedAsync" />
        @if (_filtrosVisibles.Contains("estado"))
        {
            <MudSelect T="string"
                       OuterClass="filter-field"
                       RelativeWidth="DropdownWidth.Adaptive"
                       Label="Estado"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Value="@_filtroEstado"
                       ValueChanged="OnEstadoFiltroChangedAsync">
                <MudSelectItem Value="@("")">Todos</MudSelectItem>
                <MudSelectItem Value="@("activos")">Activos</MudSelectItem>
                <MudSelectItem Value="@("inactivos")">Inactivos</MudSelectItem>
            </MudSelect>
        }
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Código</th>
                    <th class="col-numero">Precio</th>
                    <th>Inv.</th>
                    <th class="col-numero">Stock sede</th>
                    <th class="col-accion">Estado</th>
                    <th class="col-accion" style="width: 56px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_cargando)
                {
                    <tr>
                        <td colspan="7" class="empty-cell">Cargando...</td>
                    </tr>
                }
                else if (_productos.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="empty-cell">
                            @(_query.Trim().Length > 0 || _filtroEstado.Length > 0 ? "Sin resultados para los filtros aplicados" : "No hay productos en el catálogo")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in _productos)
                    {
                        var activo = p.EsActivo;
                        <tr>
                            <td><strong>@p.Descripcion</strong></td>
                            <td class="muted-cell">@(p.CodigoBarras ?? "—")</td>
                            <td class="col-numero">@FormatearMonto(p.PrecioVentaCentavos)</td>
                            <td class="muted-cell">@(p.RequiereInventario ? "Sí" : "No")</td>
                            <td class="col-numero @(EsStockBajo(p) ? "stock-bajo" : "")">
                                @(StockDe(p) is null ? "—" : StockDe(p)!.Value.ToString())
                            </td>
                            <td class="col-accion">
                                <span class="status-badge @(activo ? "status-success" : "status-danger")">
                                    @(activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="col-accion">
                                <MudMenu Open="@EsMenuAbierto(p.IdProducto)" OpenChanged="@(v => MenuOpenChanged(p.IdProducto, v))" AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight"
                                         Class="row-menu">
                                    <ActivatorContent>
                                        @* MudBlazor v9: ActivatorContent recibe MenuContext; el clic ya no
                                           abre el menu implicitamente (breaking change v9), hay que llamar
                                           context.ToggleAsync explicito. Ver
                                           https://github.com/MudBlazor/MudBlazor/issues/12666 *@<span class="morph-toggle @(EsMenuAbierto(p.IdProducto) ? "abierto" : "")"

                                        @onclick="@context.ToggleAsync"

                                        role="button" tabindex="0" aria-label="Acciones"><svg class="morph-more" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2.2"/><circle cx="12" cy="12" r="2.2"/><circle cx="12" cy="19" r="2.2"/></svg><svg class="morph-close" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.41 13.41 12z"/></svg></span>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick="() => AbrirEdicion(p)">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /> Editar
                                        </MudMenuItem>

                                        @if (activo)
                                        {
                                            @if (p.RequiereInventario)
                                            {
                                                <MudMenuItem OnClick="() => AbrirAjuste(p)">
                                                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" /> Ajustar stock
                                                </MudMenuItem>
                                            }
                                            <MudMenuItem OnClick="() => PedirDesactivar(p)">
                                                <MudIcon Icon="@Icons.Material.Filled.Pause" Size="Size.Small" /> Desactivar
                                            </MudMenuItem>
                                        }
                                        else
                                        {
                                            <MudMenuItem OnClick="() => ActivarAsync(p)">
                                                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /> Activar
                                            </MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_productos.Count > 0)
    {
        <div class="table-footer">
            <span class="muted">Mostrando @_productos.Count de @_totalRegistros producto(s)</span>
            <div class="pagination-controls">
                <MudSelect T="int"
                           Label="Ver"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           OuterClass="page-size-field"
                           RelativeWidth="DropdownWidth.Adaptive"
                           Value="_tamanoPagina"
                           ValueChanged="OnTamanoPaginaChangedAsync">
                    @foreach (var tamano in TamanosPagina.Validos)
                    {
                        <MudSelectItem Value="@tamano">@tamano</MudSelectItem>
                    }
                </MudSelect>
                @if (_totalPaginas > 1)
                {
                    <MudPagination Count="_totalPaginas"
                                   Selected="_pagina"
                                   SelectedChanged="OnPaginaChangedAsync"
                                   Color="Color.Primary"
                                   Size="Size.Small" />
                }
            </div>
        </div>
    }
</div>

<MudDialog Visible="_formAbierto"
           VisibleChanged="v => _formAbierto = v"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editandoId is null ? "Nuevo producto" : "Editar producto")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="form-fields" @onkeydown="HandleFormKeyDown">
            <MudTextField T="string"
                          Label="Descripción"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          @bind-Value="_formDescripcion" />
            <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                <MudNumericField T="decimal"
                                 Label="Precio"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Format="F2"
                                 HideSpinButtons="true"
                                 Style="flex: 1;"
                                 @bind-Value="_formPrecio" />
                <MudTextField T="string"
                              Label="Código de barras"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Style="flex: 1;"
                              @bind-Value="_formCodigoBarras" />
            </div>
            <MudSwitch T="bool" Label="Requiere inventario" Color="Color.Primary" @bind-Value="_formRequiereInventario" />
            @if (_editandoId is null && _formRequiereInventario)
            {
                <MudNumericField T="long?"
                                 Label="Stock inicial (sede actual)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 HideSpinButtons="true"
                                 @bind-Value="_formStockInicial" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_guardando" OnClick="CerrarForm">Cancelar</MudButton>
        <AsyncButton Text="Guardar"
                     LoadingText="Guardando..."
                     IsLoading="_guardando"
                     OnClick="GuardarAsync" />
    </DialogActions>
</MudDialog>

<MudDialog Visible="_ajusteAbierto"
           VisibleChanged="v => _ajusteAbierto = v"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Ajustar stock — @(_productoAjustando?.Descripcion)</MudText>
    </TitleContent>
    <DialogContent>
        @* Delta con signo: positivo = entrada, negativo = salida. El backend
           rechaza dejar el stock en negativo (conteo físico nunca es negativo). *@
        <div class="form-fields" style="max-width: 320px;" @onkeydown="HandleAjusteKeyDown">
            <p class="muted">Stock actual: @_stockAjustandoActual</p>
            <MudNumericField T="long"
                             Label="Ajuste (+ entrada / − salida)"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             HideSpinButtons="true"
                             @bind-Value="_deltaAjuste" />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_ajustando" OnClick="() => _ajusteAbierto = false">Cancelar</MudButton>
        <AsyncButton Text="Aplicar"
                     LoadingText="Aplicando..."
                     IsLoading="_ajustando"
                     OnClick="AjustarStockAsync" />
    </DialogActions>
</MudDialog>

<ConfirmDialog IsOpen="_confirmar is not null"
               Titulo="@_confirmar?.Titulo"
               Mensaje="@(_confirmar?.Mensaje ?? "")"
               TextoConfirmar="@(_confirmar?.TextoConfirmar ?? "Confirmar")"
               IsLoading="_confirmarCargando"
               OnConfirm="EjecutarConfirmar"
               OnCancel="CancelarConfirmar" />

@code {
    // Estado del menu de fila con morfeo: guarda el ID de la fila cuyo menu esta abierto (null = ninguno).
    // Se alimenta de MudMenu.OpenChanged (dispara por TODOS los caminos de cierre: item, backdrop, Escape).
    private string? _menuAbiertoId;

    private bool EsMenuAbierto(object? idFila) => idFila is not null && _menuAbiertoId == idFila.ToString();

    private void MenuOpenChanged(object? idFila, bool abierto) =>
        _menuAbiertoId = abierto
            ? idFila?.ToString()
            : (_menuAbiertoId == idFila?.ToString() ? null : _menuAbiertoId);

    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private IProductosService Productos { get; set; } = default!;
    [Inject] private IInventarioSucursalRepository Inventario { get; set; } = default!;
    [Inject] private ISedesRepository Sedes { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;

    private List<Producto> _productos = [];
    private bool _cargando;
    private string _query = "";
    private string _filtroEstado = "";

    // FiltrosDesplegables: un solo filtro secundario, visible por defecto.
    private readonly List<FiltrosDesplegables.FiltroDefinicion> _definicionesFiltros =
        [new("estado", "Estado")];
    private static readonly string[] _visiblesIniciales = ["estado"];
    private HashSet<string> _filtrosVisibles = ["estado"];
    private CancellationTokenSource? _debounce;
    private Dictionary<long, long> _stockPorProducto = [];

    private bool _showSede;
    private long _sedeSeleccionada;
    private List<Sede> _sedes = [];

    private int _pagina = 1;
    private int _tamanoPagina = TamanosPagina.Default;
    private int _totalRegistros;
    private int _totalPaginas;

    // Diálogo alta/edición.
    private bool _formAbierto;
    private long? _editandoId;
    private string _formDescripcion = "";
    private decimal _formPrecio;
    private string _formCodigoBarras = "";
    private bool _formRequiereInventario = true;
    private long? _formStockInicial;
    private bool _guardando;

    // Diálogo ajuste de stock.
    private bool _ajusteAbierto;
    private Producto? _productoAjustando;
    private long _stockAjustandoActual;
    private long _deltaAjuste;
    private bool _ajustando;

    // Confirmación de desactivación (ConfirmDialog compartido, patrón Miembros).
    private sealed record ConfirmarTarea(string Titulo, string Mensaje, string TextoConfirmar, Func<Task> Accion);
    private ConfirmarTarea? _confirmar;
    private bool _confirmarCargando;

    protected override async Task OnInitializedAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        _showSede = sesion.IdSede is null;
        if (_showSede)
        {
            try
            {
                _sedes = (await Sedes.GetActivasAsync()).ToList();
            }
            catch
            {
                _sedes = [];
            }
            _sedeSeleccionada = _sedes.FirstOrDefault()?.IdSede ?? 0;
        }

        await CargarAsync();
    }

    public void Dispose() => _debounce?.Cancel();

    private Task OnSedeChangedAsync(long value)
    {
        _sedeSeleccionada = value;
        return CargarAsync();
    }

    /// <summary>Búsqueda con debounce de 300ms (mismo comportamiento que Miembros).</summary>
    private async Task OnBusquedaChanged(string value)
    {
        _query = value;
        _pagina = 1;
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
            await CargarAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnEstadoFiltroChangedAsync(string value)
    {
        _filtroEstado = value ?? "";
        _pagina = 1;
        await CargarAsync();
    }

    /// <summary>Al ocultar el filtro se limpia su valor (nunca queda aplicado invisible).</summary>
    private async Task OnVisiblesChangedAsync(IReadOnlyList<string> visibles)
    {
        _filtrosVisibles = visibles.ToHashSet(StringComparer.Ordinal);
        if (!_filtrosVisibles.Contains("estado"))
        {
            _filtroEstado = "";
            _pagina = 1;
            await CargarAsync();
        }
    }

    private async Task OnTamanoPaginaChangedAsync(int value)
    {
        _tamanoPagina = value;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnPaginaChangedAsync(int value)
    {
        _pagina = value;
        await CargarAsync();
    }

    private bool? FiltroEstadoBool() => _filtroEstado switch
    {
        "activos" => true,
        "inactivos" => false,
        _ => null,
    };
    private async Task CargarAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        _cargando = true;
        try
        {
            var resultado = await Productos.BuscarAsync(
                sesion.Token,
                string.IsNullOrWhiteSpace(_query) ? null : _query.Trim(),
                _pagina,
                _tamanoPagina,
                FiltroEstadoBool());
            _productos = resultado.Items.ToList();
            _totalRegistros = resultado.TotalRegistros;
            _totalPaginas = resultado.TotalPaginas;

            _stockPorProducto = _showSede && _sedeSeleccionada == 0
                ? []
                : (await Inventario.GetBySedeAsync(
                    _showSede ? _sedeSeleccionada : sesion.IdSede!.Value)).ToDictionary(i => i.IdProducto, i => i.Stock);
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo cargar el catálogo");
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private long? StockDe(Producto p) =>
        p.RequiereInventario && _stockPorProducto.TryGetValue(p.IdProducto, out var stock) ? stock : null;

    private bool EsStockBajo(Producto p)
    {
        var stock = StockDe(p);
        return stock is not null && stock.Value <= 3;
    }

    private void AbrirAlta()
    {
        _editandoId = null;
        _formDescripcion = "";
        _formPrecio = 0;
        _formCodigoBarras = "";
        _formRequiereInventario = true;
        _formStockInicial = 0;
        _formAbierto = true;
    }

    private void AbrirEdicion(Producto p)
    {
        _editandoId = p.IdProducto;
        _formDescripcion = p.Descripcion;
        _formPrecio = p.PrecioVentaCentavos / 100m;
        _formCodigoBarras = p.CodigoBarras ?? "";
        _formRequiereInventario = p.RequiereInventario;
        _formAbierto = true;
    }

    private void CerrarForm()
    {
        if (!_guardando)
        {
            _formAbierto = false;
        }
    }

    private void HandleFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_guardando)
        {
            _ = GuardarAsync();
        }
        else if (e.Key == "Escape")
        {
            CerrarForm();
        }
    }

    private async Task GuardarAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null || _guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_formDescripcion))
        {
            Feedback.ShowWarning("Ingresa la descripción");
            return;
        }
        if (_formPrecio < 0)
        {
            Feedback.ShowWarning("El precio no puede ser negativo");
            return;
        }

        _guardando = true;
        try
        {
            var precioCentavos = (long)Math.Round(_formPrecio * 100, MidpointRounding.AwayFromZero);
            var codigo = string.IsNullOrWhiteSpace(_formCodigoBarras) ? null : _formCodigoBarras.Trim();

            if (_editandoId is null)
            {
                await Productos.CrearAsync(
                    sesion.Token,
                    _formDescripcion.Trim(),
                    precioCentavos,
                    codigo,
                    _formRequiereInventario,
                    _formStockInicial ?? 0,
                    _showSede ? _sedeSeleccionada : null);
                Feedback.ShowSuccess("Producto creado");
            }
            else
            {
                await Productos.EditarAsync(
                    sesion.Token, _editandoId.Value,
                    _formDescripcion.Trim(), precioCentavos, codigo, _formRequiereInventario);
                Feedback.ShowSuccess("Producto actualizado");
            }

            _formAbierto = false;
            await CargarAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo guardar el producto");
        }
        finally
        {
            _guardando = false;
        }
    }

    private void AbrirAjuste(Producto p)
    {
        _productoAjustando = p;
        _stockAjustandoActual = StockDe(p) ?? 0;
        _deltaAjuste = 0;
        _ajusteAbierto = true;
    }

    /// <summary>Enter aplica el ajuste; Escape cierra sin aplicar.</summary>
    private void HandleAjusteKeyDown(KeyboardEventArgs e)
    {
        if (_ajustando)
        {
            return;
        }
        if (e.Key == "Escape")
        {
            _ajusteAbierto = false;
        }
        else if (e.Key == "Enter")
        {
            _ = AjustarStockAsync();
        }
    }

    private async Task AjustarStockAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null || _productoAjustando is null || _ajustando)
        {
            return;
        }

        if (_deltaAjuste == 0)
        {
            Feedback.ShowWarning("El ajuste no puede ser cero");
            return;
        }

        _ajustando = true;
        try
        {
            var nuevoStock = await Productos.AjustarStockAsync(
                sesion.Token, _productoAjustando.IdProducto, _deltaAjuste,
                _showSede ? _sedeSeleccionada : null);
            Feedback.ShowSuccess($"Nuevo stock: {nuevoStock}");
            _ajusteAbierto = false;
            await CargarAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo ajustar el stock");
        }
        finally
        {
            _ajustando = false;
        }
    }

    private void PedirDesactivar(Producto p)
    {
        _confirmar = new ConfirmarTarea("Desactivar producto",
            $"¿Seguro que quieres desactivar «{p.Descripcion}»? Dejará de ser vendible, pero se conserva en el historial de ventas.",
            "Desactivar",
            () => DesactivarAsync(p));
        StateHasChanged();
    }

    private async Task DesactivarAsync(Producto p)
    {
        var sesion = Sesion.Current!;
        await Productos.DesactivarAsync(sesion.Token, p.IdProducto);
        Feedback.ShowSuccess($"Producto «{p.Descripcion}» desactivado");
        await CargarAsync();
    }

    private async Task EjecutarConfirmar()
    {
        if (_confirmar is null)
        {
            return;
        }

        _confirmarCargando = true;
        try
        {
            await _confirmar.Accion();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo completar la acción");
        }
        finally
        {
            _confirmarCargando = false;
            _confirmar = null;
            StateHasChanged();
        }
    }

    private void CancelarConfirmar()
    {
        _confirmar = null;
        StateHasChanged();
    }

    private async Task ActivarAsync(Producto p)
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        try
        {
            await Productos.ActivarAsync(sesion.Token, p.IdProducto);
            Feedback.ShowSuccess("Producto activado");
            await CargarAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
    }

    private static string FormatearMonto(long centavos) =>
        (centavos / 100m).ToString("C2", CultureInfo.GetCultureInfo("es-MX"));
}
