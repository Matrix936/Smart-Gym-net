@page "/promociones"
@* PromocionesPage: catálogo de descuentos por producto y combos con precio
   cerrado. Alta/edición/activación-desactivación; la aplicación vive en /pos
   (descuento = tachado en la línea, combo = tarjeta propia que agrega todos
   sus componentes). Vigencia efectiva calculada server-side: es_activo=true
   con fecha_fin pasada se muestra como "Vencida" y no se ofrece en POS. *@
@implements IDisposable
@using System.Globalization
@using MudBlazor
@using SmartGym.Core.Common
@using SmartGym.Core.Entities
@using SmartGym.Core.Repositories
@using SmartGym.Core.Services
@using SmartGym.App.Services

<div class="page-head">
    <div>
        <h4>Promociones</h4>
        <p class="page-sub">Descuentos por producto y combos del punto de venta.</p>
    </div>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="AbrirAlta">Nueva promoción</MudButton>
</div>

<div class="glass-panel">
    <div class="page-toolbar">
        <MudTextField T="string"
                      Class="search-field"
                      Placeholder="Buscar por nombre..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Value="@_query"
                      ValueChanged="OnBusquedaChanged" />
        <FiltrosDesplegables Filtros="_definicionesFiltros"
                             VisiblesIniciales="_visiblesIniciales"
                             ConteoAplicados="(_filtroTipo.Length > 0 ? 1 : 0) + (_filtroEstado.Length > 0 ? 1 : 0)"
                             VisiblesChanged="OnVisiblesChangedAsync" />
        @if (_filtrosVisibles.Contains("tipo"))
        {
            <MudSelect T="string"
                       OuterClass="filter-field"
                       RelativeWidth="DropdownWidth.Adaptive"
                       Label="Tipo"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Value="@_filtroTipo"
                       ValueChanged="OnTipoFiltroChangedAsync">
                <MudSelectItem Value="@("")">Todos</MudSelectItem>
                <MudSelectItem Value="@("descuento")">Descuentos</MudSelectItem>
                <MudSelectItem Value="@("combo")">Combos</MudSelectItem>
            </MudSelect>
        }
        @if (_filtrosVisibles.Contains("estado"))
        {
            <MudSelect T="string"
                       OuterClass="filter-field"
                       RelativeWidth="DropdownWidth.Adaptive"
                       Label="Estado"
                       Margin="Margin.Dense"
                       Variant="Variant.Outlined"
                       Value="@_filtroEstado"
                       ValueChanged="OnEstadoFiltroChangedAsync">
                <MudSelectItem Value="@("")">Todos</MudSelectItem>
                <MudSelectItem Value="@("activos")">Activos</MudSelectItem>
                <MudSelectItem Value="@("inactivos")">Inactivos</MudSelectItem>
            </MudSelect>
        }
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Detalle</th>
                    <th>Vigencia</th>
                    <th class="col-accion">Estado</th>
                    <th class="col-accion" style="width: 56px;"></th>
                </tr>
            </thead>
            <tbody>
                @if (_cargando)
                {
                    <tr>
                        <td colspan="6" class="empty-cell">Cargando...</td>
                    </tr>
                }
                else if (_promos.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="empty-cell">
                            @(_query.Trim().Length > 0 || _filtroTipo.Length > 0 || _filtroEstado.Length > 0 ? "Sin resultados para los filtros aplicados" : "No hay promociones en el catálogo")
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var info in _promos)
                    {
                        var p = info.Promocion;
                        var activo = p.EsActivo;
                        <tr>
                            <td><strong>@p.Nombre</strong></td>
                            <td>
                                <span class="status-badge @(p.Tipo == PromocionTipos.Combo ? "status-info" : "status-warning")">
                                    @(p.Tipo == PromocionTipos.Combo ? "Combo" : "Descuento")
                                </span>
                            </td>
                            <td class="muted-cell">
                                @if (p.Tipo == PromocionTipos.Descuento)
                                {
                                    @($"{info.DescripcionProducto ?? "—"} · {TextoDescuento(p)}")
                                }
                                else
                                {
                                    @($"{string.Join(" + ", info.Componentes.Select(c => $"{c.Cantidad}× {c.DescripcionProducto}"))} · {FormatearMonto(p.PrecioComboCentavos ?? 0)}")
                                }
                            </td>
                            <td class="muted-cell">@TextoVigencia(p)</td>
                            <td style="text-align: center;">
                                <span class="status-badge @(info.VigenteHoy ? "status-success" : (activo ? "status-danger" : "status-muted"))">
                                    @(info.VigenteHoy ? "Vigente" : (activo ? "Inactiva o vencida" : "Inactiva"))
                                </span>
                            </td>
                            <td style="text-align: center;">
                                <MudMenu AnchorOrigin="Origin.BottomRight"
                                         TransformOrigin="Origin.TopRight"
                                         Class="row-menu">
                                    <ActivatorContent>
                                        <span class="morph-toggle"
                                              @onclick="@context.ToggleAsync"
                                              role="button" tabindex="0" aria-label="Acciones"><svg class="morph-more" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2.2"/><circle cx="12" cy="12" r="2.2"/><circle cx="12" cy="19" r="2.2"/></svg><svg class="morph-close" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.41 13.41 12z"/></svg></span>
                                    </ActivatorContent>
                                    <ChildContent>
                                        <MudMenuItem OnClick="() => AbrirEdicion(info)">
                                            <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" /> Editar
                                        </MudMenuItem>

                                        @if (activo)
                                        {
                                            <MudMenuItem OnClick="() => PedirDesactivar(info)">
                                                <MudIcon Icon="@Icons.Material.Filled.Pause" Size="Size.Small" /> Desactivar
                                            </MudMenuItem>
                                        }
                                        else
                                        {
                                            <MudMenuItem OnClick="() => ActivarAsync(info)">
                                                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Small" /> Activar
                                            </MudMenuItem>
                                        }
                                    </ChildContent>
                                </MudMenu>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (_promos.Count > 0)
    {
        <div class="table-footer">
            <span class="muted">Mostrando @_promos.Count de @_totalRegistros promoción(es)</span>
            <div class="pagination-controls">
                <MudSelect T="int"
                           Label="Ver"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           OuterClass="page-size-field"
                           RelativeWidth="DropdownWidth.Adaptive"
                           Value="_tamanoPagina"
                           ValueChanged="OnTamanoPaginaChangedAsync">
                    @foreach (var tamano in TamanosPagina.Validos)
                    {
                        <MudSelectItem Value="@tamano">@tamano</MudSelectItem>
                    }
                </MudSelect>
                @if (_totalPaginas > 1)
                {
                    <MudPagination Count="_totalPaginas"
                                   Selected="_pagina"
                                   SelectedChanged="OnPaginaChangedAsync"
                                   Color="Color.Primary"
                                   Size="Size.Small" />
                }
            </div>
        </div>
    }
</div>

<MudDialog Visible="_formAbierto"
           VisibleChanged="v => _formAbierto = v"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@(_editandoId is null ? "Nueva promoción" : "Editar promoción")</MudText>
    </TitleContent>
    <DialogContent>
        <div class="form-fields" @onkeydown="HandleFormKeyDown">
            <MudSelect T="string"
                       Label="Tipo de promoción"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Disabled="_editandoId is not null"
                       @bind-Value="_formTipo">
                <MudSelectItem Value="@("descuento")">Descuento sobre un producto</MudSelectItem>
                <MudSelectItem Value="@("combo")">Combo (productos a precio cerrado)</MudSelectItem>
            </MudSelect>
            <MudTextField T="string"
                          Label="Nombre"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          @bind-Value="_formNombre" />
            <MudTextField T="string"
                          Label="Descripción (opcional)"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Immediate="true"
                          @bind-Value="_formDescripcion" />

            @if (_formTipo == "descuento")
            {
                <MudSelect T="long?"
                           Label="Producto"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           RelativeWidth="DropdownWidth.Adaptive"
                           @bind-Value="_formIdProducto">
                    @foreach (var prod in _productosDisponibles)
                    {
                        <MudSelectItem Value="@((long?)prod.IdProducto)">@prod.Descripcion</MudSelectItem>
                    }
                </MudSelect>
                <div style="display: flex; gap: 0.75rem; align-items: flex-start;">
                    <MudSelect T="string"
                               Label="Tipo de descuento"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="flex: 1;"
                               @bind-Value="_formTipoDescuento">
                        <MudSelectItem Value="@("porcentaje")">Porcentaje (%)</MudSelectItem>
                        <MudSelectItem Value="@("monto_fijo")">Monto fijo ($)</MudSelectItem>
                    </MudSelect>
                    @if (_formTipoDescuento == "porcentaje")
                    {
                        <MudNumericField T="long"
                                         Label="Porcentaje"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1" Max="100"
                                         HideSpinButtons="true"
                                         Style="flex: 1;"
                                         @bind-Value="_formValorEntero" />
                    }
                    else
                    {
                        <MudNumericField T="decimal"
                                         Label="Descuento"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="0"
                                         Format="F2"
                                         HideSpinButtons="true"
                                         Style="flex: 1;"
                                         @bind-Value="_formValorMonto" />
                    }
                </div>
            }
            else
            {
                <MudNumericField T="decimal"
                                 Label="Precio del combo"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Min="0"
                                 Format="F2"
                                 HideSpinButtons="true"
                                 @bind-Value="_formPrecioCombo" />
                @if (SubtotalComponentes > PrecioComboCentavos && _componentesForm.Count > 0)
                {
                    <p class="muted">Componentes: @SubtotalComponentesTexto - ahorro: @AhorroComboTexto</p>
                }

                <MudText Typo="Typo.subtitle2">Componentes</MudText>
                @foreach (var (componente, idx) in _componentesForm.Select((c, i) => (c, i)))
                {
                    var index = idx;
                    <div style="display: flex; gap: 0.75rem; align-items: center;">
                        <MudSelect T="long"
                                   Label="Producto"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   RelativeWidth="DropdownWidth.Adaptive"
                                   Style="flex: 3;"
                                   Value="@componente.IdProducto"
                                   ValueChanged="v => OnComponenteProductoChanged(index, v)">
                            @foreach (var prod in _productosDisponibles)
                            {
                                <MudSelectItem Value="@prod.IdProducto">@prod.Descripcion</MudSelectItem>
                            }
                        </MudSelect>
                        <MudNumericField T="long"
                                         Label="Cant."
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Min="1"
                                         HideSpinButtons="true"
                                         Style="flex: 1;"
                                         Value="@componente.Cantidad"
                                         ValueChanged="v => OnComponenteCantidadChanged(index, v)" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       Variant="Variant.Text"
                                       OnClick="() => QuitarComponente(index)" />
                    </div>
                }
                <MudButton Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="AgregarComponente">Agregar componente</MudButton>
            }

            <div style="display: flex; gap: 0.75rem;">
                <MudDatePicker T="DateTime?"
                               Label="Inicio (opcional)"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="flex: 1;"
                               Date="@_formFechaInicio"
                               DateChanged="OnFechaInicioChanged" />
                <MudDatePicker T="DateTime?"
                               Label="Fin (opcional)"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Style="flex: 1;"
                               Date="@_formFechaFin"
                               DateChanged="OnFechaFinChanged" />
            </div>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_guardando" OnClick="CerrarForm">Cancelar</MudButton>
        <AsyncButton Text="Guardar"
                     LoadingText="Guardando..."
                     IsLoading="_guardando"
                     OnClick="GuardarAsync" />
    </DialogActions>
</MudDialog>

<ConfirmDialog IsOpen="_confirmar is not null"
               Titulo="@_confirmar?.Titulo"
               Mensaje="@(_confirmar?.Mensaje ?? "")"
               TextoConfirmar="@(_confirmar?.TextoConfirmar ?? "Confirmar")"
               IsLoading="_confirmarCargando"
               OnConfirm="EjecutarConfirmar"
               OnCancel="CancelarConfirmar" />

@code {
    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private IPromocionesService Promociones { get; set; } = default!;
    [Inject] private IProductosService Productos { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;

    private List<PromocionInfo> _promos = [];
    private List<Producto> _productosDisponibles = [];
    private bool _cargando;
    private string _query = "";
    private string _filtroTipo = "";
    private string _filtroEstado = "";

    private readonly List<FiltrosDesplegables.FiltroDefinicion> _definicionesFiltros =
        [new("tipo", "Tipo"), new("estado", "Estado")];
    private static readonly string[] _visiblesIniciales = ["tipo"];
    private HashSet<string> _filtrosVisibles = ["tipo"];
    private CancellationTokenSource? _debounce;

    private int _pagina = 1;
    private int _tamanoPagina = TamanosPagina.Default;
    private int _totalRegistros;
    private int _totalPaginas;

    // Diálogo alta/edición.
    private bool _formAbierto;
    private string? _editandoId;
    private string _formTipo = "descuento";
    private string _formNombre = "";
    private string _formDescripcion = "";
    private long? _formIdProducto;
    private string _formTipoDescuento = "porcentaje";
    private long _formValorEntero = 10;
    private decimal _formValorMonto;
    private decimal _formPrecioCombo;
    private DateTime? _formFechaInicio;
    private DateTime? _formFechaFin;
    private bool _guardando;

    /// <summary>Filas de componentes del combo en edición (id, cantidad).</summary>
    private List<ComponenteForm> _componentesForm = [];

    private sealed record ComponenteForm(long IdProducto, long Cantidad);

    private sealed record ConfirmarTarea(string Titulo, string Mensaje, string TextoConfirmar, Func<Task> Accion);
    private ConfirmarTarea? _confirmar;
    private bool _confirmarCargando;

    protected override async Task OnInitializedAsync()
    {
        if (Sesion.Current is null)
        {
            return;
        }

        await CargarProductosDisponiblesAsync();
        await CargarAsync();
    }

    public void Dispose() => _debounce?.Cancel();

    private async Task CargarProductosDisponiblesAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null) return;
        try
        {
            var resultado = await Productos.BuscarAsync(sesion.Token, null, pagina: 1, tamanoPagina: TamanosPagina.Cincuenta, esActivo: true);
            _productosDisponibles = resultado.Items.ToList();
        }
        catch
        {
            _productosDisponibles = [];
        }
    }

    private async Task OnBusquedaChanged(string value)
    {
        _query = value;
        _pagina = 1;
        _debounce?.Cancel();
        var cts = _debounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
            await CargarAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task OnTipoFiltroChangedAsync(string value)
    {
        _filtroTipo = value ?? "";
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnEstadoFiltroChangedAsync(string value)
    {
        _filtroEstado = value ?? "";
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnVisiblesChangedAsync(IReadOnlyList<string> visibles)
    {
        _filtrosVisibles = visibles.ToHashSet(StringComparer.Ordinal);
        if (!_filtrosVisibles.Contains("tipo"))
        {
            _filtroTipo = "";
        }
        if (!_filtrosVisibles.Contains("estado"))
        {
            _filtroEstado = "";
        }
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnTamanoPaginaChangedAsync(int value)
    {
        _tamanoPagina = value;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnPaginaChangedAsync(int value)
    {
        _pagina = value;
        await CargarAsync();
    }

    private bool? FiltroEstadoBool() => _filtroEstado switch
    {
        "activos" => true,
        "inactivos" => false,
        _ => null,
    };

    private async Task CargarAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        _cargando = true;
        try
        {
            var resultado = await Promociones.BuscarAsync(
                sesion.Token,
                string.IsNullOrWhiteSpace(_query) ? null : _query.Trim(),
                _filtroTipo.Length == 0 ? null : _filtroTipo,
                FiltroEstadoBool(),
                _pagina,
                _tamanoPagina);
            _promos = resultado.Items.ToList();
            _totalRegistros = resultado.TotalRegistros;
            _totalPaginas = resultado.TotalPaginas;
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo cargar el catálogo de promociones");
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private void AbrirAlta()
    {
        _editandoId = null;
        _formTipo = "descuento";
        _formNombre = "";
        _formDescripcion = "";
        _formIdProducto = null;
        _formTipoDescuento = "porcentaje";
        _formValorEntero = 10;
        _formValorMonto = 0;
        _formPrecioCombo = 0;
        _formFechaInicio = null;
        _formFechaFin = null;
        _componentesForm = [];
        _formAbierto = true;
    }

    private void AbrirEdicion(PromocionInfo info)
    {
        var p = info.Promocion;
        _editandoId = p.IdPromocion;
        _formTipo = p.Tipo;
        _formNombre = p.Nombre;
        _formDescripcion = p.Descripcion ?? "";
        _formIdProducto = p.IdProducto;
        _formTipoDescuento = p.TipoDescuento ?? "porcentaje";
        _formValorEntero = p.Valor ?? 0;
        _formValorMonto = (p.Valor ?? 0) / 100m;
        _formPrecioCombo = (p.PrecioComboCentavos ?? 0) / 100m;
        _formFechaInicio = ParseFechaSolo(p.FechaInicio);
        _formFechaFin = ParseFechaSolo(p.FechaFin);
        _componentesForm = info.Componentes
            .Select(c => new ComponenteForm(c.IdProducto, c.Cantidad))
            .ToList();
        _formAbierto = true;
    }

    private static DateTime? ParseFechaSolo(string? fecha) =>
        DateTime.TryParseExact(fecha, "yyyy-MM-dd", CultureInfo.InvariantCulture,
            DateTimeStyles.None, out var f) ? f : null;

    private void CerrarForm()
    {
        if (!_guardando)
        {
            _formAbierto = false;
        }
    }

    private void HandleFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !_guardando)
        {
            _ = GuardarAsync();
        }
        else if (e.Key == "Escape")
        {
            CerrarForm();
        }
    }

    private void AgregarComponente()
    {
        var idLibre = _productosDisponibles.FirstOrDefault(p => _componentesForm.All(c => c.IdProducto != p.IdProducto))?.IdProducto;
        if (idLibre is null)
        {
            return;
        }
        _componentesForm.Add(new ComponenteForm(idLibre.Value, 1));
    }

    private void QuitarComponente(int idx)
    {
        if (idx >= 0 && idx < _componentesForm.Count)
        {
            _componentesForm.RemoveAt(idx);
        }
    }

    private void OnComponenteProductoChanged(int idx, long idProducto)
    {
        if (idx < _componentesForm.Count)
        {
            _componentesForm[idx] = _componentesForm[idx] with { IdProducto = idProducto };
        }
    }

    private void OnComponenteCantidadChanged(int idx, long cantidad)
    {
        if (idx < _componentesForm.Count && cantidad > 0)
        {
            _componentesForm[idx] = _componentesForm[idx] with { Cantidad = cantidad };
        }
    }

    private long SubtotalComponentes =>
        _componentesForm.Sum(c =>
            (_productosDisponibles.FirstOrDefault(p => p.IdProducto == c.IdProducto)?.PrecioVentaCentavos ?? 0) * c.Cantidad);

    private string SubtotalComponentesTexto => FormatearMonto(SubtotalComponentes);

    private long PrecioComboCentavos => (long)Math.Round(_formPrecioCombo * 100, MidpointRounding.AwayFromZero);

    private string AhorroComboTexto => FormatearMonto(Math.Max(0, SubtotalComponentes - PrecioComboCentavos));

    private async Task OnFechaInicioChanged(DateTime? value)
    {
        _formFechaInicio = value;
    }

    private async Task OnFechaFinChanged(DateTime? value)
    {
        _formFechaFin = value;
    }

    private async Task GuardarAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null || _guardando)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_formNombre))
        {
            Feedback.ShowWarning("Ingresa el nombre de la promoción");
            return;
        }

        _guardando = true;
        try
        {
            if (_editandoId is null)
            {
                if (_formTipo == "descuento")
                {
                    if (_formIdProducto is null)
                    {
                        Feedback.ShowWarning("Selecciona el producto");
                        return;
                    }
                    await CrearDescuentoAsync(sesion);
                    Feedback.ShowSuccess("Descuento creado");
                }
                else
                {
                    if (_componentesForm.Count == 0)
                    {
                        Feedback.ShowWarning("Agrega al menos un componente al combo");
                        return;
                    }
                    await Promociones.CrearComboAsync(sesion.Token,
                        _formNombre.Trim(), NullSiVacio(_formDescripcion), PrecioComboCentavos,
                        ComponentesDeForm(), _formFechaInicio, _formFechaFin);
                    Feedback.ShowSuccess("Combo creado");
                }
            }
            else if (_formTipo == "descuento")
            {
                await EditarDescuentoAsync(sesion);
                Feedback.ShowSuccess("Promoción actualizada");
            }
            else
            {
                await Promociones.EditarComboAsync(sesion.Token, _editandoId,
                    _formNombre.Trim(), NullSiVacio(_formDescripcion), PrecioComboCentavos,
                    ComponentesDeForm(), _formFechaInicio, _formFechaFin);
                Feedback.ShowSuccess("Promoción actualizada");
            }

            _formAbierto = false;
            await CargarAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo guardar la promoción");
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task CrearDescuentoAsync(SessionInfo sesion)
    {
        if (_formTipoDescuento == "porcentaje")
        {
            await Promociones.CrearDescuentoAsync(sesion.Token,
                _formNombre.Trim(), NullSiVacio(_formDescripcion), _formIdProducto!.Value,
                PromocionTiposDescuento.Porcentaje, _formValorEntero,
                _formFechaInicio, _formFechaFin);
        }
        else
        {
            await Promociones.CrearDescuentoAsync(sesion.Token,
                _formNombre.Trim(), NullSiVacio(_formDescripcion), _formIdProducto!.Value,
                PromocionTiposDescuento.MontoFijo, AValorMontoCentavos(),
                _formFechaInicio, _formFechaFin);
        }
    }

    private async Task EditarDescuentoAsync(SessionInfo sesion)
    {
        if (_formTipoDescuento == "porcentaje")
        {
            await Promociones.EditarDescuentoAsync(sesion.Token, _editandoId!,
                _formNombre.Trim(), NullSiVacio(_formDescripcion), _formIdProducto!.Value,
                PromocionTiposDescuento.Porcentaje, _formValorEntero,
                _formFechaInicio, _formFechaFin);
        }
        else
        {
            await Promociones.EditarDescuentoAsync(sesion.Token, _editandoId!,
                _formNombre.Trim(), NullSiVacio(_formDescripcion), _formIdProducto!.Value,
                PromocionTiposDescuento.MontoFijo, AValorMontoCentavos(),
                _formFechaInicio, _formFechaFin);
        }
    }

    private long AValorMontoCentavos() =>
        (long)Math.Round(_formValorMonto * 100, MidpointRounding.AwayFromZero);

    private IReadOnlyList<PromocionComponente> ComponentesDeForm() =>
        _componentesForm.Select(c => new PromocionComponente { IdProducto = c.IdProducto, Cantidad = c.Cantidad }).ToList();

    private static string? NullSiVacio(string texto) =>
        string.IsNullOrWhiteSpace(texto) ? null : texto.Trim();

    private void PedirDesactivar(PromocionInfo info)
    {
        _confirmar = new ConfirmarTarea("Desactivar promoción",
            $"¿Seguro que quieres desactivar «{info.Promocion.Nombre}»? Dejará de ofrecerse en el punto de venta.",
            "Desactivar",
            () => DesactivarAsync(info));
        StateHasChanged();
    }

    private async Task DesactivarAsync(PromocionInfo info)
    {
        var sesion = Sesion.Current!;
        await Promociones.DesactivarAsync(sesion.Token, info.Promocion.IdPromocion);
        Feedback.ShowSuccess($"Promoción «{info.Promocion.Nombre}» desactivada");
        await CargarAsync();
    }

    private async Task ActivarAsync(PromocionInfo info)
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        try
        {
            await Promociones.ActivarAsync(sesion.Token, info.Promocion.IdPromocion);
            Feedback.ShowSuccess("Promoción activada");
            await CargarAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
    }

    private async Task EjecutarConfirmar()
    {
        if (_confirmar is null)
        {
            return;
        }

        _confirmarCargando = true;
        try
        {
            await _confirmar.Accion();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo completar la acción");
        }
        finally
        {
            _confirmarCargando = false;
            _confirmar = null;
            StateHasChanged();
        }
    }

    private void CancelarConfirmar()
    {
        _confirmar = null;
        StateHasChanged();
    }

    private static string TextoDescuento(Promocion p) =>
        p.TipoDescuento == PromocionTiposDescuento.Porcentaje
            ? $"-{p.Valor}%"
            : $"-{FormatearMonto(p.Valor ?? 0)}";

    /// <summary>Vigencia efectiva legible; nulls = extremos abiertos.</summary>
    private static string TextoVigencia(Promocion p)
    {
        var inicio = p.FechaInicio ?? "siempre";
        var fin = p.FechaFin ?? "sin fin";
        return inicio == "siempre" && fin == "sin fin" ? "Permanente" : $"{inicio} → {fin}";
    }

    private static string FormatearMonto(long centavos) =>
        (centavos / 100m).ToString("C2", CultureInfo.GetCultureInfo("es-MX"));
}
