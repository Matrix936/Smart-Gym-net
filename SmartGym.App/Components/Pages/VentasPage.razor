@page "/ventas"
@* El generador de Razor emite el código con contexto nullable desactivado y
   ignora "#nullable enable" a nivel de archivo (dotnet/razor#8720, backlog).
   Este page usa anotaciones anulables en markup (T="long?", (long?) casts del
   selector de vendedor), así que suprimimos CS8669 para todo el archivo. *@
@{
#pragma warning disable CS8669
}
@* VentasPage: historial unificado de lo que mueve dinero en caja — ventas POS,
   cancelaciones, pagos de membresía y abonos. Fuente: caja_movimientos con
   joins polimórficos (ver CajaMovimientosRepository.BuscarHistorialAsync).
   Solo lectura salvo cancelar venta POS completada (reutiliza
   PosService.CancelarVentaAsync con reautorización por contraseña). *@
@using System.Globalization
@using MudBlazor
@using SmartGym.Core.Authorization
@using SmartGym.Core.Common
@using SmartGym.Core.Entities
@using SmartGym.Core.Printing
@using SmartGym.Core.Repositories
@using SmartGym.Core.Services
@using SmartGym.App.Services

<div class="page-head">
    <div>
        <h4>Ventas</h4>
        <p class="page-sub">Historial de ventas, cancelaciones, membresías y abonos de la sede.</p>
    </div>
</div>

<div class="glass-panel">
    <div class="page-toolbar">
        @* Folio primero (búsqueda puntual, fuera del menú de filtros);
           Tipo es filtro primario siempre visible; la sede conserva su
           lógica condicional de superadmin multi-sede. *@
        <MudTextField T="string"
                      Class="search-field"
                      Placeholder="Buscar por folio..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Margin="Margin.Dense"
                      Immediate="true"
                      Value="@_folioBusqueda"
                      ValueChanged="OnFolioBusquedaChangedAsync" />
        <MudDatePicker t="DateTime?"
                       Label="Desde"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Date="_desde"
                       DateChanged="OnDesdeChangedAsync" />
        <MudDatePicker t="DateTime?"
                       Label="Hasta"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Date="_hasta"
                       DateChanged="OnHastaChangedAsync" />
        <MudSelect T="string?"
                   Label="Tipo"
                   Variant="Variant.Outlined"
                   Margin="Margin.Dense"
                   Clearable="true"
                   Value="_tipo"
                   ValueChanged="OnTipoChangedAsync">
            <MudSelectItem T="string?" Value="null">Todos</MudSelectItem>
            <MudSelectItem T="string?" Value="@CajaReferenciaTipos.Venta">Venta</MudSelectItem>
            @* Sin opción "Cancelación": las cancelaciones ya no son filas
               propias del listado — el estado vive en la fila de la venta. *@
            <MudSelectItem T="string?" Value="@CajaReferenciaTipos.PagoMembresia">Membresía</MudSelectItem>
            <MudSelectItem T="string?" Value="@CajaReferenciaTipos.Abono">Abono</MudSelectItem>
        </MudSelect>
        <FiltrosDesplegables Filtros="_definicionesFiltros"
                             VisiblesIniciales="_visiblesIniciales"
                             ConteoAplicados="ConteoAplicados"
                             VisiblesChanged="OnVisiblesChangedAsync" />
        @if (_showSede && _sedes.Count > 1 && _filtrosVisibles.Contains("sede"))
        {
            <MudSelect T="long"
                       Label="Sede"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       OuterClass="filter-field"
                       RelativeWidth="DropdownWidth.Adaptive"
                       Value="_sedeSeleccionada"
                       ValueChanged="OnSedeChangedAsync">
                <MudSelectItem Value="@SedeFiltroTodas">Todas las sedes</MudSelectItem>
                @foreach (var sede in _sedes)
                {
                    <MudSelectItem Value="@sede.IdSede">@sede.Nombre</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_filtrosVisibles.Contains("socio"))
        {
            <MudAutocomplete T="Socio"
                             Label="Socio"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             SearchFunc="@BuscarSociosAsync"
                             ToStringFunc="@(s => s is null ? "" : $"{s.Nombre} {s.ApellidoPaterno}".Trim())"
                             MaxItems="10"
                             MinCharacters="0"
                             ResetValueOnEmptyText="true"
                             Clearable="true"
                             Value="_socioSeleccionado"
                             ValueChanged="OnSocioChangedAsync" />
        }
        @if (_filtrosVisibles.Contains("vendedor"))
        {
            <MudSelect T="long?"
                       Label="Vendedor"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Value="_idVendedor"
                       ValueChanged="OnVendedorChangedAsync">
                <MudSelectItem T="long?" Value="null">Todos</MudSelectItem>
                @foreach (var u in _vendedores)
                {
                    <MudSelectItem Value="@((long?)u.IdUsuario)">@($"{u.Nombre} {u.ApellidoPaterno}".Trim())</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_filtrosVisibles.Contains("metodo"))
        {
            <MudSelect T="string?"
                       Label="Método"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Value="_metodoPago"
                       ValueChanged="OnMetodoChangedAsync">
                <MudSelectItem T="string?" Value="null">Todos</MudSelectItem>
                @foreach (var m in MetodosPago.Todos)
                {
                    <MudSelectItem T="string?" Value="@m">@Capitalizar(m)</MudSelectItem>
                }
            </MudSelect>
        }
        @if (_filtrosVisibles.Contains("estado"))
        {
            <MudSelect T="string?"
                       Label="Estado venta"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true"
                       Value="_estadoVenta"
                       ValueChanged="OnEstadoChangedAsync">
                <MudSelectItem T="string?" Value="null">Todos</MudSelectItem>
                <MudSelectItem T="string?" Value="@VentaEstados.Completada">Completada</MudSelectItem>
                <MudSelectItem T="string?" Value="@VentaEstados.Cancelada">Cancelada</MudSelectItem>
            </MudSelect>
        }
    </div>

    @if (_cargando)
    {
        <p class="muted">Cargando...</p>
    }
    else if (_filas.Count == 0)
    {
        <p class="muted" style="margin-top: 1rem;">Sin movimientos para los filtros actuales.</p>
    }
    else
    {
        <div class="table-wrap" style="margin-top: 1rem;">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Tipo</th>
                        <th>Concepto</th>
                        <th class="col-socio">Socio</th>
                        <th>Método</th>
                        <th class="col-numero">Monto</th>
                        <th class="col-accion" style="width: 56px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var f in _filas)
                    {
                        <tr>
                            <td class="muted-cell">@FormatearFecha(f.Fecha)</td>
                            <td><span class="status-badge @ClaseBadge(f)">@EtiquetaTipo(f)</span></td>
                            <td>@(string.IsNullOrEmpty(f.Concepto) ? "—" : f.Concepto)</td>
                            <td class="col-socio muted-cell">@(f.NombreSocio ?? "—")</td>
                            <td class="muted-cell">@Capitalizar(f.MetodoPago)</td>
                            <td class="col-numero" style="@(f.MontoCentavos < 0 ? "color: var(--color-error);" : "")">
                                @(f.MontoCentavos < 0 ? "−" : "")@FormatearMonto(Math.Abs(f.MontoCentavos))
                            </td>
                            <td class="col-accion">
                                @if (f.ReferenciaTipo == CajaReferenciaTipos.Venta || f.ReferenciaTipo == CajaReferenciaTipos.CancelacionVenta)
                                {
                                    @* Mismo menú de tres puntos que el resto de las tablas
                                       (Miembros/Membresías/Bitácora): MorphToggle + ToggleAsync
                                       explícito por el breaking change de MudBlazor v9. *@
                                    <MudMenu AnchorOrigin="Origin.BottomRight"
                                             TransformOrigin="Origin.TopRight"
                                             Class="row-menu">
                                        <ActivatorContent>
                                            @* MudBlazor v9: ActivatorContent recibe MenuContext; el clic ya no
                                               abre el menu implicitamente (breaking change v9), hay que llamar
                                               context.ToggleAsync explicito. Ver
                                               https://github.com/MudBlazor/MudBlazor/issues/12666 *@<span class="morph-toggle"

                                            @onclick="@context.ToggleAsync"

                                            role="button" tabindex="0" aria-label="Acciones"><svg class="morph-more" viewBox="0 0 24 24" fill="currentColor"><circle cx="12" cy="5" r="2.2"/><circle cx="12" cy="12" r="2.2"/><circle cx="12" cy="19" r="2.2"/></svg><svg class="morph-close" viewBox="0 0 24 24" fill="currentColor"><path d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.41 13.41 12z"/></svg></span>
                                        </ActivatorContent>
                                        <ChildContent>
                                            <MudMenuItem OnClick='() => VerDetalleAsync(f)'>
                                                <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" /> Ver detalle
                                            </MudMenuItem>

                                            @if (f.EsVentaCancelable && TienePermisoCancelar)
                                            {
                                                <MudMenuItem OnClick='() => AbrirCancelacion(f)'>
                                                    <MudIcon Icon="@Icons.Material.Filled.Cancel" Size="Size.Small" /> Cancelar
                                                </MudMenuItem>
                                            }
                                        </ChildContent>
                                    </MudMenu>
                                }
                                else
                                {
                                    <span class="muted-cell">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer">
            <span class="muted">Mostrando @_filas.Count de @_totalRegistros movimiento(s)</span>
            <div class="pagination-controls">
                <MudSelect T="int"
                           Label="Ver"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           OuterClass="page-size-field"
                           RelativeWidth="DropdownWidth.Adaptive"
                           Value="_tamanoPagina"
                           ValueChanged="OnTamanoPaginaChangedAsync">
                    @foreach (var tamano in TamanosPagina.Validos)
                    {
                        <MudSelectItem Value="@tamano">@tamano</MudSelectItem>
                    }
                </MudSelect>
                @if (_totalPaginas > 1)
                {
                    <MudPagination Count="_totalPaginas"
                                   Selected="_pagina"
                                   SelectedChanged="OnPaginaChangedAsync"
                                   Color="Color.Primary"
                                   Size="Size.Small" />
                }
            </div>
        </div>
    }
</div>

<MudDialog Visible="_detalleAbierto"
           VisibleChanged="v => _detalleAbierto = v"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Detalle de venta</MudText>
    </TitleContent>
    <DialogContent>
        @* Dos zonas separadas: "Detalles" (fuera del papel: folio completo para
           soporte/búsqueda y la línea de cancelación) y la previsualización del
           ticket, idéntica a lo que sale impreso (folio corto de 8 chars, sin
           datos de cancelación). *@
        @if (_detalleCargando)
        {
            <p class="muted">Cargando...</p>
        }
        else if (_detalleVenta is not null)
        {
            string? estadoDetalle = null;
            if (_detalleVenta.CanceladaElIsoUtc is not null && _detalleVenta.Estado == VentaEstados.Cancelada)
            {
                var por = string.IsNullOrWhiteSpace(_detalleVenta.CanceladaPor) ? "" : $" — por {_detalleVenta.CanceladaPor}";
                estadoDetalle = $"{FormatearFecha(_detalleVenta.CanceladaElIsoUtc)}{por}";
            }

            @* ---- Zona 1: Detalles (no se imprime) ---- *@
            <div class="venta-detalles">
                <p class="venta-detalles-titulo">Detalles</p>
                <div class="tk-row">
                    <span>Folio</span>
                    <span style="overflow-wrap: anywhere;">@_detalleVenta.IdVenta</span>
                </div>
                @if (estadoDetalle is not null)
                {
                    <div class="tk-row">
                        <span>Cancelada</span>
                        <span>@estadoDetalle</span>
                    </div>
                }
            </div>

            @* ---- Zona 2: Previsualización del ticket (lo que sale impreso) ---- *@
            <p class="venta-detalles-titulo" style="text-align: center;">Previsualización del ticket</p>
            <TicketPreview Folio="@FolioCorto(_detalleVenta.IdVenta)"
                           Fecha="@(_filaDetalle is null ? "—" : FormatearFecha(_filaDetalle.Fecha))"
                           Atendio="@_atendioDetalle"
                           MetodoPago="@Capitalizar(_detalleVenta.MetodoPago)"
                           Estado="@_detalleVenta.Estado"
                           Socio="@_filaDetalle?.NombreSocio"
                           Items="@ItemsDeDetalle()"
                           TotalCentavos="@_detalleVenta.TotalCentavos"
                           EmpresaNombre="@_negocioTicket?.Empresa"
                           Rfc="@_negocioTicket?.Rfc"
                           SedeNombre="@_negocioTicket?.Sede"
                           Direccion="@_negocioTicket?.Direccion"
                           Telefono="@_negocioTicket?.Telefono"
                           MensajePie="@_negocioTicket?.MensajePie"
                           LogoSrc="@_logoDataUrl" />
        }
    </DialogContent>
    <DialogActions>
        <AsyncButton Text="Reimprimir"
                     LoadingText="Imprimiendo..."
                     IsLoading="_imprimiendoReimpresion"
                     Disabled="@(_detalleCargando || _imprimiendoReimpresion)"
                     OnClick="ReimprimirVentaAsync" />
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="() => _detalleAbierto = false">Cerrar</MudButton>
    </DialogActions>
</MudDialog>

<MudDialog Visible="_cancelacionAbierta"
           VisibleChanged="v => _cancelacionAbierta = v"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = true, CloseOnEscapeKey = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">Cancelar venta</MudText>
    </TitleContent>
    <DialogContent>
        @* Mismo criterio que el cierre de caja: confirmación en dos pasos y
            reautorización por contraseña (la validación real vive en
            PosService.CancelarVentaAsync, que además regresa stock y genera
            el egreso en caja). *@
        <div @onkeydown="HandleCancelacionKeyDown">
            <p class="form-section">Se anulará la venta @(_filaCancelando?.ReferenciaId) y se generará un egreso en caja.</p>
            @if (_cancelacionPaso == 1)
            {
                <p class="muted">¿Deseas continuar?</p>
            }
            else
            {
                <PasswordField Label="Confirma tu contraseña" Autocomplete="current-password" @bind-Value="_cancelacionPassword" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (_cancelacionPaso == 1)
        {
            <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="CerrarCancelacion">No</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="() => _cancelacionPaso = 2">Sí, continuar</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Text" Color="Color.Default" Disabled="_cancelando" OnClick="() => _cancelacionPaso = 1">Atrás</MudButton>
            <AsyncButton Text="Cancelar venta" LoadingText="Cancelando..." IsLoading="_cancelando" OnClick="CancelarVentaAsync" />
        }
    </DialogActions>
</MudDialog>

@implements IDisposable
@code {
    [Inject] private ISessionState Sesion { get; set; } = default!;
    [Inject] private IVentasService Ventas { get; set; } = default!;
    [Inject] private IPosService Pos { get; set; } = default!;
    [Inject] private IAuthorizationService Authz { get; set; } = default!;
    [Inject] private ISociosRepository SociosRepo { get; set; } = default!;
    [Inject] private IUsuariosRepository UsuariosRepo { get; set; } = default!;
    [Inject] private ISedesRepository Sedes { get; set; } = default!;
    [Inject] private IFeedbackService Feedback { get; set; } = default!;
    [Inject] private IEmpresaConfigService EmpresaConfig { get; set; } = default!;
    [Inject] private SmartGym.Core.Services.ITerminalConfigStore Terminal { get; set; } = default!;

    private bool _cargando = true;
    private bool _showSede;
    private long _sedeSeleccionada;
    private List<Sede> _sedes = [];
    private List<Usuario> _vendedores = [];

    private DateTime? _desde;
    private DateTime? _hasta;
    private Socio? _socioSeleccionado;
    private long? _idVendedor;
    private string? _tipo;
    private string? _metodoPago;
    private string? _estadoVenta;
    private string _folioBusqueda = "";
    private CancellationTokenSource? _folioDebounce;

    /// <summary>0 = "Todas las sedes" (no se envía idSede al servicio).</summary>
    private const long SedeFiltroTodas = 0;

    /// <summary>idSede efectivo: solo cuando el filtro de sede está encendido y con sede elegida.</summary>
    private long? SedeActiva =>
        _showSede && _filtrosVisibles.Contains("sede") && _sedeSeleccionada > 0
            ? _sedeSeleccionada
            : null;

    // FiltrosDesplegables: socio visible por defecto; vendedor/método/estado/sede ocultos.
    // Tipo ya no vive en el menú: es filtro primario siempre visible.
    private readonly List<FiltrosDesplegables.FiltroDefinicion> _definicionesFiltros = new()
    {
        new("socio", "Socio"),
        new("vendedor", "Vendedor"),
        new("metodo", "Método"),
        new("estado", "Estado venta"),
        new("sede", "Sede"),
    };
    // Ningún filtro secundario activo por defecto: Tipo es primario siempre
    // visible; los del menú se encienden bajo demanda.
    private static readonly string[] _visiblesIniciales = [];
    private HashSet<string> _filtrosVisibles = [];

    private int ConteoAplicados =>
        (_socioSeleccionado is not null ? 1 : 0) +
        (_idVendedor is not null ? 1 : 0) +
        (_metodoPago is not null ? 1 : 0) +
        (_estadoVenta is not null ? 1 : 0) +
        (SedeActiva is not null ? 1 : 0);

    private List<MovimientoHistorialDto> _filas = [];
    private int _pagina = 1;
    private int _tamanoPagina = TamanosPagina.Default;
    private int _totalRegistros;
    private int _totalPaginas;

    // El permiso de cancelar se consulta una sola vez (no por fila).
    private bool _tienePermisoCancelar;
    private bool TienePermisoCancelar => _tienePermisoCancelar;

    private bool _detalleAbierto;
    private bool _detalleCargando;
    private VentaInfo? _detalleVenta;
    private MovimientoHistorialDto? _filaDetalle;

    // Reimpresión de tickets (Configuración → Periféricos).
    [Inject] private ITicketPrintService Print { get; set; } = default!;
    private string? _impresoraTickets;
    private int _papelAncho = 42;
    private int _densidad = 2;
    private bool _imprimiendoReimpresion;
    private TicketDatosNegocio? _negocioTicket;
    private byte[]? _logoRasterCache;
    private string? _logoDataUrl;

    private MovimientoHistorialDto? _filaCancelando;
    private bool _cancelacionAbierta;
    private int _cancelacionPaso = 1;

    /// <summary>Nombre del vendedor para el detalle ("Atendió"); null si la venta no tiene.</summary>
    private string? _atendioDetalle;
    private string _cancelacionPassword = "";
    private bool _cancelando;

    protected override async Task OnInitializedAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        try
        {
            await Authz.RequierePermisoAsync(sesion.Token, PermisoCatalogo.PosVerHistorial);
        }
        catch (BusinessException)
        {
            Feedback.ShowError("No tienes permiso para ver el historial de ventas");
            return;
        }

        try
        {
            await Authz.RequierePermisoAsync(sesion.Token, PermisoCatalogo.PosCancelarVenta);
            _tienePermisoCancelar = true;
        }
        catch (BusinessException)
        {
            // Sin permiso de cancelación: solo se oculta el botón.
        }

        _desde = DateTime.Today.AddDays(-7);
        _showSede = sesion.IdSede is null;
        if (_showSede)
        {
            try
            {
                _sedes = (await Sedes.GetActivasAsync()).ToList();
            }
            catch
            {
                _sedes = [];
            }

            // Preselección al encender el filtro: la sede de ESTA terminal
            // (mismo mecanismo del Kiosco) si está configurada; si no, "Todas".
            var idSedeTerminal = await Terminal.ObtenerIdSedeAsync();
            _sedeSeleccionada = idSedeTerminal is not null && _sedes.Any(s => s.IdSede == idSedeTerminal.Value)
                ? idSedeTerminal.Value
                : SedeFiltroTodas;
        }

        try
        {
            _vendedores = (await UsuariosRepo.GetActivosAsync()).ToList();
        }
        catch
        {
            _vendedores = [];
        }

        // Periféricos al montar (mismo patrón que PosPage): sin esto el guard de
        // "Reimprimir" corta antes del lazy-load y siempre reportaría sin impresora.
        try
        {
            var perifericos = await EmpresaConfig.ObtenerPerifericosAsync(sesion.Token);
            _impresoraTickets = perifericos.ImpresoraTickets;
            _papelAncho = perifericos.PapelAncho;
            _densidad = perifericos.Densidad;
        }
        catch (BusinessException)
        {
            // Sin sesión válida o sin configuración: defaults (impresión manual).
        }

        await CargarAsync();
    }

    private Task OnSedeChangedAsync(long value) => EjecutarConSedeAsync(value);

    private async Task EjecutarConSedeAsync(long value)
    {
        _sedeSeleccionada = value;
        await CargarAsync();
    }

    private async Task<IEnumerable<Socio?>> BuscarSociosAsync(string arg, CancellationToken ct)
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return [];
        }
        var pagina = await SociosRepo.SearchAsync(string.IsNullOrWhiteSpace(arg) ? null : arg.Trim(), pagina: 1, tamanoPagina: 10, ct: ct);
        return pagina.Items.Cast<Socio?>();
    }

    private async Task OnSocioChangedAsync(Socio? socio)
    {
        _socioSeleccionado = socio;
        _pagina = 1;
        await CargarAsync();
    }

    /// <summary>Al ocultar un filtro se limpia su valor (nunca queda aplicado invisible).</summary>
    private async Task OnVisiblesChangedAsync(IReadOnlyList<string> visibles)
    {
        _filtrosVisibles = visibles.ToHashSet(StringComparer.Ordinal);
        if (_socioSeleccionado is not null && !_filtrosVisibles.Contains("socio"))
        {
            _socioSeleccionado = null;
        }
        if (!_filtrosVisibles.Contains("vendedor"))
        {
            _idVendedor = null;
        }
        if (!_filtrosVisibles.Contains("metodo"))
        {
            _metodoPago = null;
        }
        if (!_filtrosVisibles.Contains("estado"))
        {
            _estadoVenta = null;
        }
        if (!_filtrosVisibles.Contains("sede"))
        {
            _sedeSeleccionada = SedeFiltroTodas;
        }
        _pagina = 1;
        await CargarAsync();
    }

    private Task OnVendedorChangedAsync(long? value) => CambiarFiltroAsync(() => _idVendedor = value == 0 ? null : value);

    private Task OnTipoChangedAsync(string? value) => CambiarFiltroAsync(() => _tipo = NormalizarNulo(value));

    /// <summary>Búsqueda de folio con debounce de 300ms y reset de página
    /// (mismo patrón que el buscador de Miembros/Productos).</summary>
    private async Task OnFolioBusquedaChangedAsync(string value)
    {
        _folioBusqueda = value ?? "";
        _pagina = 1;
        _folioDebounce?.Cancel();
        var cts = _folioDebounce = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, cts.Token);
            await CargarAsync();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private Task OnMetodoChangedAsync(string? value) => CambiarFiltroAsync(() => _metodoPago = NormalizarNulo(value));

    private Task OnEstadoChangedAsync(string? value) => CambiarFiltroAsync(() => _estadoVenta = NormalizarNulo(value));

    /// <summary>MudDatePicker bindea con Date/DateChanged (no Value/ValueChanged):
    /// sin esto, elegir fecha actualizaba el picker pero nunca filtraba.</summary>
    private async Task OnDesdeChangedAsync(DateTime? value)
    {
        _desde = value;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnHastaChangedAsync(DateTime? value)
    {
        _hasta = value;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnTamanoPaginaChangedAsync(int value)
    {
        _tamanoPagina = value;
        _pagina = 1;
        await CargarAsync();
    }

    private async Task OnPaginaChangedAsync(int value)
    {
        _pagina = value;
        await CargarAsync();
    }

    /// <summary>MudSelect dispara ValueChanged con el valor placeholder ("Todos")
    /// como item real: normalizamos ese caso a null antes de filtrar.</summary>
    private static string? NormalizarNulo(string? valor) => string.IsNullOrWhiteSpace(valor) ? null : valor;

    private async Task CambiarFiltroAsync(Action setter)
    {
        setter();
        _pagina = 1;
        await CargarAsync();
    }

    private HistorialFiltros ConstruirFiltros()
    {
        return new HistorialFiltros
        {
            Desde = AIsoUtcInicioDia(_desde),
            Hasta = AIsoUtcFinDia(_hasta),
            TipoReferencia = _tipo,
            MetodoPago = _metodoPago,
            EstadoVenta = _estadoVenta,
            IdSocio = _socioSeleccionado?.IdSocio,
            IdVendedor = _idVendedor,
            Folio = string.IsNullOrWhiteSpace(_folioBusqueda) ? null : _folioBusqueda.Trim(),
        };
    }

    private async Task CargarAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        _cargando = true;
        try
        {
            var resultado = await Ventas.BuscarHistorialAsync(
                sesion.Token,
                ConstruirFiltros(),
                _pagina,
                _tamanoPagina,
                SedeActiva);
            _filas = resultado.Items.ToList();
            _totalRegistros = resultado.TotalRegistros;
            _totalPaginas = resultado.TotalPaginas;
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo cargar el historial");
        }
        finally
        {
            _cargando = false;
            StateHasChanged();
        }
    }

    private async Task VerDetalleAsync(MovimientoHistorialDto fila)
    {
        if (fila.ReferenciaId is null)
        {
            return;
        }

        var sesion = Sesion.Current;
        if (sesion is null)
        {
            return;
        }

        _filaDetalle = fila;
        _detalleAbierto = true;
        _detalleCargando = true;
        _detalleVenta = null;
        _atendioDetalle = null;
        StateHasChanged();
        try
        {
            // Sede de LA FILA (no la del filtro): el detalle exige sede concreta.
            _detalleVenta = await Ventas.ObtenerDetalleVentaAsync(
                sesion.Token,
                fila.ReferenciaId,
                fila.IdSede);

            // Atendió: nombre del usuario que registró la venta (IdVendedor).
            if (_detalleVenta.IdVendedor is not null)
            {
                var vendedor = await UsuariosRepo.GetByIdAsync(_detalleVenta.IdVendedor.Value);
                _atendioDetalle = vendedor is null
                    ? null
                    : string.Join(" ", new[] { vendedor.Nombre, vendedor.ApellidoPaterno }
                        .Where(p => !string.IsNullOrWhiteSpace(p)));
            }

            // El preview de ticket necesita empresa/sede/logo: primera vez por sesión.
            try
            {
                await CargarContextoTicketAsync();
            }
            catch (BusinessException)
            {
                // Preview con defaults; Reimprimir reportará su propio error si aplica.
            }
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
            _detalleAbierto = false;
        }
        catch
        {
            Feedback.ShowError("No se pudo cargar el detalle de la venta");
            _detalleAbierto = false;
        }
        finally
        {
            _detalleCargando = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Reimpresión del ticket desde el detalle. Nota: si la venta fue a crédito,
    /// el saldo/vencimiento no viaja en el historial — el ticket reimpresso sale
    /// sin ese bloque; el original lo imprimió completo al momento de la venta.
    /// </summary>
    private async Task ReimprimirVentaAsync()
    {
        if (_detalleVenta is null || _imprimiendoReimpresion)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_impresoraTickets))
        {
            Feedback.ShowWarning("Sin impresora de tickets — configúrala en Configuración → Periféricos");
            return;
        }

        _imprimiendoReimpresion = true;
        StateHasChanged();
        try
        {
            await CargarContextoTicketAsync();

            var payload = TicketVentaMapper.DesdeVenta(
                folio: _detalleVenta.IdVenta,
                fechaTexto: TicketVentaMapper.FormatearFechaIso(_filaDetalle?.Fecha) ?? "—",
                metodoPago: _detalleVenta.MetodoPago,
                estado: _detalleVenta.Estado,
                socio: _filaDetalle?.NombreSocio,
                items: _detalleVenta.Items,
                totalCentavos: _detalleVenta.TotalCentavos,
                saldoPendienteCentavos: 0,
                venceTexto: null,
                negocio: _negocioTicket!,
                logoRaster: _logoRasterCache,
                papelAncho: _papelAncho,
                densidad: _densidad,
                abrirCajon: false);

            await Print.ImprimirRawAsync(_impresoraTickets.Trim(), TicketEscposBuilder.Build(payload));
            Feedback.ShowSuccess($"Ticket enviado a {_impresoraTickets}");
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo imprimir el ticket");
        }
        finally
        {
            _imprimiendoReimpresion = false;
            StateHasChanged();
        }
    }

    /// <summary>Periféricos + datos de empresa/sede/logo: una sola carga por sesión.</summary>
    private async Task CargarContextoTicketAsync()
    {
        if (_negocioTicket is not null)
        {
            return;
        }

        var sesion = Sesion.Current;
        if (sesion is null)
        {
            throw BusinessException.Validation("Sesión no válida", "sesion_invalida");
        }

        try
        {
            var perifericos = await EmpresaConfig.ObtenerPerifericosAsync(sesion.Token);
            _impresoraTickets = perifericos.ImpresoraTickets;
            _papelAncho = perifericos.PapelAncho;
            _densidad = perifericos.Densidad;
        }
        catch (BusinessException)
        {
            // Defaults: impresión manual sin impresora.
        }

        try
        {
            var (empresa, sede, logoDataUrl) = await EmpresaConfig.ObtenerAsync(sesion.Token);
            _negocioTicket = new TicketDatosNegocio(
                empresa.NombreComercial,
                empresa.Rfc,
                sede.Nombre,
                sede.Direccion,
                sede.Telefono,

                // Nombre corto (sin apellido materno): sesion.Nombre trae las
                // tres partes y no es lo que el ticket debe mostrar.
                Cajero: await ResolverNombreCortoAsync(sesion),
                MensajePie: null);
            _logoDataUrl = logoDataUrl;
            _logoRasterCache = await Print.RasterizarLogoAsync(
                TicketVentaMapper.DecodificarDataUrl(logoDataUrl) ?? [], _papelAncho, 384);
        }
        catch (BusinessException)
        {
            _negocioTicket = new TicketDatosNegocio(null, null, "Smart Gym", null, null, "POS", null);
        }
    }

    /// <summary>Detalle de la venta → items del preview/ticket.</summary>
    private IReadOnlyList<SmartGym.Core.Printing.TicketItemInput> ItemsDeDetalle() =>
        _detalleVenta!.Items.Select(i => new SmartGym.Core.Printing.TicketItemInput(
            i.DescripcionProducto ?? $"#{i.IdProducto}", i.Cantidad,
            i.PrecioUnitarioCentavos, i.SubtotalCentavos)).ToList();

    private void AbrirCancelacion(MovimientoHistorialDto fila)
    {
        _filaCancelando = fila;
        _cancelacionPassword = "";
        _cancelacionPaso = 1;
        _cancelacionAbierta = true;
    }

    private void CerrarCancelacion()
    {
        if (!_cancelando)
        {
            _cancelacionAbierta = false;
        }
    }

    /// <summary>Enter avanza paso 1→2 o confirma la cancelación en paso 2;
    /// Escape cierra sin guardar (mismo criterio que el cierre de caja).</summary>
    private void HandleCancelacionKeyDown(KeyboardEventArgs e)
    {
        if (_cancelando)
        {
            return;
        }

        if (e.Key == "Escape")
        {
            CerrarCancelacion();
        }
        else if (e.Key == "Enter")
        {
            if (_cancelacionPaso == 1)
            {
                _cancelacionPaso = 2;
                StateHasChanged();
            }
            else
            {
                _ = CancelarVentaAsync();
            }
        }
    }

    private async Task CancelarVentaAsync()
    {
        var sesion = Sesion.Current;
        if (sesion is null || _filaCancelando?.ReferenciaId is null || _cancelando)
        {
            return;
        }

        if (string.IsNullOrEmpty(_cancelacionPassword))
        {
            Feedback.ShowWarning("Ingresa tu contraseña");
            return;
        }

        _cancelando = true;
        try
        {
            // Sede de LA FILA: la cancelación es una escritura y exige sede concreta.
            await Pos.CancelarVentaAsync(sesion.Token, new CancelarVentaInput
            {
                IdVenta = _filaCancelando.ReferenciaId,
                PasswordConfirmacion = _cancelacionPassword,
            }, _filaCancelando.IdSede);
            Feedback.ShowSuccess("Venta cancelada");
            _cancelacionAbierta = false;
            await CargarAsync();
        }
        catch (BusinessException ex)
        {
            Feedback.ShowError(ex.Message);
        }
        catch
        {
            Feedback.ShowError("No se pudo cancelar la venta");
        }
        finally
        {
            _cancelando = false;
        }
    }

    private static string ClaseBadge(MovimientoHistorialDto f) => f.ReferenciaTipo switch
    {
        CajaReferenciaTipos.Venta => f.EstadoVenta == VentaEstados.Cancelada ? "status-danger" : "status-success",
        CajaReferenciaTipos.CancelacionVenta => "status-danger",
        CajaReferenciaTipos.PagoMembresia => "status-info",
        CajaReferenciaTipos.Abono => "status-warning",
        _ => "status-info",
    };

    private static string EtiquetaTipo(MovimientoHistorialDto f) => f.ReferenciaTipo switch
    {
        CajaReferenciaTipos.Venta => "Venta",
        CajaReferenciaTipos.CancelacionVenta => "Cancelación",
        CajaReferenciaTipos.PagoMembresia => "Membresía",
        CajaReferenciaTipos.Abono => "Abono",
        _ => f.TipoMovimiento,
    };

    private static string Capitalizar(string texto) =>
        string.IsNullOrEmpty(texto) ? texto : char.ToUpperInvariant(texto[0]) + texto[1..];

    private static string FormatearMonto(long centavos) =>
        (centavos / 100m).ToString("C2", CultureInfo.GetCultureInfo("es-MX"));

    private static string FormatearFecha(string iso)
    {
        if (DateTimeOffset.TryParse(iso, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var dto))
        {
            return dto.ToLocalTime().ToString("dd/MM/yyyy HH:mm", CultureInfo.GetCultureInfo("es-MX"));
        }
        return iso;
    }

    /// <summary>Inicio del día local → ISO UTC, mismo formato strftime que usa la DB.</summary>
    private static string? AIsoUtcInicioDia(DateTime? fechaLocal) =>
        fechaLocal is null ? null : ToIsoUtc(fechaLocal.Value.Date);

    /// <summary>Fin del día local (23:59:59.999) → ISO UTC inclusivo.</summary>
    private static string? AIsoUtcFinDia(DateTime? fechaLocal) =>
        fechaLocal is null ? null : ToIsoUtc(fechaLocal.Value.Date.AddDays(1).AddMilliseconds(-1));

    private static string ToIsoUtc(DateTime local)
    {
        var utc = local.Kind == DateTimeKind.Utc ? local : local.ToUniversalTime();
        return utc.ToString("yyyy-MM-dd'T'HH:mm:ss.fff'Z'", CultureInfo.InvariantCulture);
    }

    /// <summary>Mismo criterio que el ticket impreso: prefijo corto del folio.</summary>
    private static string FolioCorto(string folio) =>
        folio.Length <= 8 ? folio : folio[..8];

    /// <summary>Nombre corto (sin apellido materno) para el Cajero del ticket; cacheado por sesión.</summary>
    private string? _nombreCortoCache;

    private async Task<string> ResolverNombreCortoAsync(SessionInfo sesion)
    {
        if (_nombreCortoCache is not null)
        {
            return _nombreCortoCache;
        }

        try
        {
            var usuario = await UsuariosRepo.GetByIdAsync(sesion.IdUsuario);
            _nombreCortoCache = usuario is null
                ? "POS"
                : string.Join(" ", new[] { usuario.Nombre, usuario.ApellidoPaterno }
                    .Where(p => !string.IsNullOrWhiteSpace(p)));
        }
        catch
        {
            _nombreCortoCache = "POS";
        }
        return string.IsNullOrWhiteSpace(_nombreCortoCache) ? "POS" : _nombreCortoCache;
    }

    public void Dispose() => _folioDebounce?.Cancel();
}

