@* PasswordField (PasswordField.tsx): MudTextField tipo password con toggle mostrar/ocultar. *@
<MudTextField T="string"
              Variant="@Variant"
              Margin="Margin.Dense"
              Label="@Label"
              Immediate="@Immediate"
              InputType="@(_show ? InputType.Text : InputType.Password)"
              Value="@Value"
              ValueChanged="OnValueChanged"
              Placeholder="@Placeholder"
              autocomplete="@Autocomplete"
              Disabled="@Disabled"
              Error="@HasError"
              ErrorText="@Error"
              Adornment="Adornment.End"
              AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
              AdornmentAriaLabel="@(_show ? "Ocultar contraseña" : "Mostrar contraseña")"
              OnAdornmentClick="Toggle" />

@code {
    [Parameter] public string Label { get; set; } = "Contraseña";
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Autocomplete { get; set; }
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;

    /// <summary>
    /// Commit del texto por tecla en vez de por blur. Actívalo cuando el
    /// formulario confirma con Enter vía @onkeydown de contenedor: sin esto,
    /// el primer Enter valida con el valor stale (vacío) y hace falta un
    /// segundo Enter (bug visto en bloqueo/cancelaciones/cierre de caja).
    /// </summary>
    [Parameter] public bool Immediate { get; set; }

    private bool _show;

    private bool HasError => !string.IsNullOrEmpty(Error);

    private Task OnValueChanged(string value) => ValueChanged.InvokeAsync(value);

    private void Toggle() => _show = !_show;
}
