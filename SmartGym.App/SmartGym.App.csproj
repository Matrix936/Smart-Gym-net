<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>

        <OutputType>Exe</OutputType>
        <RootNamespace>SmartGym.App</RootNamespace>
        <UseMaui>true</UseMaui>

        <!-- Ícono win32 embebido en el ejecutable (barra de tareas/explorador). -->
        <ApplicationIcon>Resources\AppIcon\logos.ico</ApplicationIcon>

        <!-- Metadatos del ejecutable (Propiedades de Windows → Detalles).
             Nota: la "Descripción del archivo" que muestra Explorer sale de
             AssemblyTitle, por eso el texto largo vive ahí. -->
        <AssemblyName>Smart Gym</AssemblyName>
        <AssemblyTitle>Sistema de gestión para gimnasios — membresías, control de acceso, punto de venta y finanzas</AssemblyTitle>
        <Product>Smart Gym</Product>
        <Company>Cuber</Company>
        <Copyright>© 2026 Cuber</Copyright>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>

        <!-- Sin sufijo "+hash" en ProductVersion (Propiedades → Detalles). -->
        <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
        <SingleProject>true</SingleProject>

        <!-- Requerido por DPFP.Capture.Capture.MessageEvents (SDK DigitalPersona): su
             message pump interno depende de System.Windows.Forms. Sin esto, StartCapture()
             lanza FileNotFoundException al no poder cargar el ensamblado.
             NOTA: UseWindowsForms=true rompe el build (MC6000 - el markup compiler WPF
             de Microsoft.NET.Sdk.WindowsDesktop entra en conflicto con los .xaml de MAUI/
             WinUI3, App.xaml/MainPage.xaml). Se referencia el shared framework directamente
             en vez de activar el SDK de escritorio completo. Ver
             docs/migracion-dotnet/04-integracion-biometrica.md §3 y prototipo /biometric-test. -->
        <ImplicitUsings>enable</ImplicitUsings>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <Nullable>enable</Nullable>

        <!-- Enable XAML source generation for faster build times and improved performance. -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Display name -->
        <ApplicationTitle>Smart Gym</ApplicationTitle>

        <!-- App Identifier -->
        <ApplicationId>com.smartgym.app</ApplicationId>

        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Unpackaged (desktop, no MSIX) — simple dev/runtime for a gym POS -->
        <WindowsPackageType>None</WindowsPackageType>

        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#00d2ff" />

        <!-- .ico multi-resolución para la barra de título (AppWindow.SetIcon en MauiProgram). -->
        <Content Include="Resources\AppIcon\logos.ico" CopyToOutputDirectory="PreserveNewest" />

        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#00d2ff" BaseSize="128,128" />

        <!-- Images -->
        <MauiImage Include="Resources\Images\*" />
        <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

        <!-- Custom Fonts (MAUI-native; Hanken Grotesk also lives in wwwroot for Blazor CSS) -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Raw Assets -->
        <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
        <PackageReference Include="MudBlazor" Version="9.8.0" />
        <PackageReference Include="Plugin.Maui.Audio" Version="4.0.0" />
        <!-- Rasterización del logo del ticket a ESC/POS (GS v 0). Solo decodificación
             de imágenes: PNG/JPG/WEBP. SVG no soportado en v1 (ticket sale sin logo). -->
        <PackageReference Include="SkiaSharp" Version="4.151.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\SmartGym.Core\SmartGym.Core.csproj" />
        <ProjectReference Include="..\SmartGym.Data\SmartGym.Data.csproj" />
    </ItemGroup>

    <!-- Prototipo biometrico (temporal, no productivo): copias verbatim del sidecar
         Rust como referencia de lectura, excluidas de compilacion porque dependen
         de Config/HttpServer/Models que no se trajeron. Ver BiometricPrototype/. -->
    <ItemGroup>
        <Compile Remove="BiometricPrototype\Reference\**\*.cs" />
    </ItemGroup>

    <!-- Shared framework de WinForms (solo el ensamblado, sin activar UseWindowsForms/UseWPF) -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <FrameworkReference Include="Microsoft.WindowsDesktop.App.WindowsForms" />
    </ItemGroup>

    <!-- SDK DigitalPersona One Touch (prototipo biometrico) -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <Reference Include="DPFPDevNET">
            <HintPath>C:\Program Files\DigitalPersona\One Touch SDK\.NET\Bin\DPFPDevNET.dll</HintPath>
            <Private>True</Private>
        </Reference>
        <Reference Include="DPFPEngNET">
            <HintPath>C:\Program Files\DigitalPersona\One Touch SDK\.NET\Bin\DPFPEngNET.dll</HintPath>
            <Private>True</Private>
        </Reference>
        <Reference Include="DPFPVerNET">
            <HintPath>C:\Program Files\DigitalPersona\One Touch SDK\.NET\Bin\DPFPVerNET.dll</HintPath>
            <Private>True</Private>
        </Reference>
        <Reference Include="DPFPShrNET">
            <HintPath>C:\Program Files\DigitalPersona\One Touch SDK\.NET\Bin\DPFPShrNET.dll</HintPath>
            <Private>True</Private>
        </Reference>
    </ItemGroup>

</Project>
